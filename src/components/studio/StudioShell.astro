---
import "../../styles/studio.css";

const { active = "dashboard" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const navItems: { key: string; label: string; href: string; ownerOnly?: boolean }[] = [
    { key: "dashboard", label: "Dashboard", href: `${base}/studio` },
    { key: "articles", label: "Articles", href: `${base}/studio/articles` },
    { key: "editor", label: "New article", href: `${base}/studio/editor` },
    { key: "media", label: "Media", href: `${base}/studio/media` },
    { key: "settings", label: "Settings", href: `${base}/studio/settings` },
    { key: "users", label: "Users", href: `${base}/studio/users`, ownerOnly: true },
];
---

<div class="studio-shell">
    <aside class="studio-sidebar" aria-label="Studio navigation">
        <div class="studio-brand">
            <div class="studio-brand__mark">TJ</div>
            <div>
                <p class="studio-brand__eyebrow">Private Studio</p>
                <h1>The Technology Joint</h1>
            </div>
        </div>

        <nav class="studio-nav">
            {
                navItems.map((item) => (
                    <a
                        class:list={[item.key === active ? "active" : ""]}
                        href={item.href}
                        {...(item.ownerOnly ? { "data-owner-only": "" } : {})}
                        style={item.ownerOnly ? "display:none" : undefined}
                    >
                        {item.label}
                    </a>
                ))
            }
        </nav>

        <div class="studio-sidebar__footer">
            <div class="studio-card" data-role-card>
                <p class="studio-card__eyebrow">Current role</p>
                <strong>Writer</strong>
                <p>Secure workspace for drafting and reviewing content.</p>
            </div>
            <button class="studio-signout" type="button" data-studio-signout>
                Sign out
            </button>
        </div>
    </aside>

    <main class="studio-main" id="main-content">
        <slot />
    </main>
</div>

<script>
    import { getApiBase } from "../../lib/studio/github";

    const signOut = document.querySelector<HTMLButtonElement>(
        "[data-studio-signout]",
    );

    signOut?.addEventListener("click", async () => {
        const apiBase = getApiBase();
        if (apiBase) {
            try {
                await fetch(`${apiBase}/api/auth/logout`, {
                    method: "POST",
                    credentials: "include",
                });
            } catch {
                // best-effort — local redirect still happens
            }
        }
        window.sessionStorage.removeItem("studio-auth");
        const base = import.meta.env.BASE_URL.replace(/\/$/, "");
        window.location.assign(`${base}/studio/login`);
    });

    // Show the signed-in user in the sidebar footer (team / OAuth mode).
    // The API returns { login } (OAuth) or { username } (team); getSession
    // normalizes both to user.login.
    const roleCard = document.querySelector<HTMLElement>(
        ".studio-card[data-role-card]",
    );
    const apiBase = getApiBase();
    if (apiBase && roleCard) {
        fetch(`${apiBase}/api/auth/session`, { credentials: "include" })
            .then((res) => res.json())
            .then((data) => {
                if (data?.authenticated && data?.user) {
                    const login = data.user.login || data.user.username || "";
                    const label = roleCard.querySelector("strong");
                    if (label) label.textContent = login ? `@${login}` : "Editor";
                    const note = roleCard.querySelector("p");
                    if (note) {
                        note.textContent = `Signed in to the Studio. Edits commit to the live repository.`;
                    }
                    // Show owner-only nav items
                    if (data.user.role === "owner") {
                        document.querySelectorAll("[data-owner-only]").forEach((el) => {
                            (el as HTMLElement).style.display = "";
                        });
                        if (label) {
                            label.textContent = login ? `@${login} (Owner)` : "Editor";
                        }
                    }
                }
            })
            .catch(() => {
                // ignore — footer keeps its default copy
            });
    }
</script>

<style>
    .studio-shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 280px minmax(0, 1fr);
        background: var(--color-background);
        color: var(--color-text);
    }

    .studio-sidebar {
        padding: 2rem 1.25rem;
        border-right: 1px solid var(--color-border);
        background: color-mix(
            in srgb,
            var(--color-surface) 92%,
            var(--color-background)
        );
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        position: sticky;
        top: 0;
        align-self: start;
        height: 100vh;
        overflow-y: auto;
    }

    .studio-brand {
        display: flex;
        align-items: center;
        gap: 0.9rem;
    }

    .studio-brand__mark {
        display: inline-grid;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 999px;
        background: linear-gradient(
            135deg,
            var(--color-primary),
            var(--color-accent)
        );
        color: white;
        font-weight: 700;
        flex-shrink: 0;
    }

    .studio-brand h1 {
        margin: 0;
        font-size: 1.05rem;
        line-height: 1.25;
    }

    .studio-brand__eyebrow,
    .studio-card__eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.16em;
        font-size: 0.72rem;
        color: var(--color-muted);
        margin: 0 0 0.35rem;
    }

    .studio-nav {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .studio-nav a {
        color: var(--color-text);
        padding: 0.85rem 0.95rem;
        border-radius: var(--radius-md);
        text-decoration: none;
        transition:
            background var(--transition),
            color var(--transition);
        min-height: 44px;
        display: flex;
        align-items: center;
        font-weight: 500;
    }

    .studio-nav a.active,
    .studio-nav a:hover {
        background: var(--color-primary-soft);
        color: var(--color-primary-dark);
    }

    .studio-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        padding: 1rem;
    }

    .studio-card p {
        margin: 0.35rem 0 0;
        color: var(--color-muted);
        font-size: 0.85rem;
        line-height: 1.45;
    }

    .studio-sidebar__footer {
        margin-top: auto;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
    }

    .studio-signout {
        border: 1px solid var(--color-border);
        background: transparent;
        color: var(--color-muted);
        border-radius: 999px;
        padding: 0.65rem 0.9rem;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
        min-height: 44px;
        transition:
            color var(--transition),
            border-color var(--transition);
    }

    .studio-signout:hover {
        color: var(--color-danger);
        border-color: var(--color-danger);
    }

    .studio-main {
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        min-width: 0;
    }

    @media (max-width: 960px) {
        .studio-shell {
            grid-template-columns: 1fr;
        }

        .studio-sidebar {
            border-right: 0;
            border-bottom: 1px solid var(--color-border);
            height: auto;
            position: sticky;
            top: 0;
            z-index: 20;
            padding-bottom: 1rem;
        }

        .studio-sidebar__footer {
            margin-top: 0;
            flex-direction: row;
            flex-wrap: wrap;
            align-items: center;
        }

        .studio-sidebar__footer .studio-card {
            flex: 1 1 100%;
        }

        .studio-nav {
            flex-direction: row;
            flex-wrap: nowrap;
            overflow-x: auto;
            gap: 0.35rem;
            padding-bottom: 0.25rem;
            scrollbar-width: none;
            -webkit-overflow-scrolling: touch;
        }

        .studio-nav::-webkit-scrollbar {
            display: none;
        }

        .studio-nav a {
            white-space: nowrap;
            padding: 0.7rem 0.9rem;
        }

        .studio-main {
            padding: 1.25rem;
        }
    }

    @media (max-width: 480px) {
        .studio-sidebar {
            padding: 1rem 0.9rem;
        }

        .studio-brand {
            gap: 0.6rem;
        }

        .studio-brand__mark {
            width: 2.25rem;
            height: 2.25rem;
            font-size: 0.85rem;
        }

        .studio-brand h1 {
            font-size: 0.95rem;
        }

        .studio-brand__eyebrow {
            font-size: 0.66rem;
        }

        .studio-nav a {
            padding: 0.6rem 0.75rem;
            font-size: 0.92rem;
        }

        .studio-card {
            padding: 0.8rem;
        }

        .studio-main {
            padding: 1rem 0.9rem;
        }
    }
</style>
