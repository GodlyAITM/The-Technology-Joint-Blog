---
import Navigation from "./Navigation.astro";
import { SITE } from "../../config/site";

const base = import.meta.env.BASE_URL;
---

<header>
    <div class="container header">
        <a href={base} class="logo">
            <img src={SITE.logo} alt="The Technology Joint logo" />
            <span>{SITE.name}</span>
        </a>

        <Navigation />

        <div class="theme-switch" role="group" aria-label="Theme">
            <button
                type="button"
                data-theme-choice="light"
                aria-pressed="false"
            >
                Light
            </button>
            <button
                type="button"
                data-theme-choice="dark"
                aria-pressed="false"
            >
                Dark
            </button>
            <button
                type="button"
                data-theme-choice="system"
                aria-pressed="false"
            >
                System
            </button>
        </div>
    </div>
</header>

<style>
    header {
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
        position: sticky;
        top: 0;
        z-index: 999;
        transition: background var(--transition);
    }

    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 0;
        /* Anchor for the mobile nav dropdown panel */
        flex-wrap: wrap;
        position: relative;
    }

    .logo {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--color-text);
    }

    .logo img {
        width: 36px;
        height: 36px;
        object-fit: contain;
        border-radius: 12px;
        background: var(--color-surface-alt);
    }

    .theme-switch {
        display: inline-flex;
        align-items: center;
        padding: 3px;
        gap: 2px;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        background: var(--color-surface-alt);
    }

    .theme-switch button {
        border: 0;
        background: transparent;
        color: var(--color-muted);
        font: inherit;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.55rem 0.8rem;
        border-radius: 999px;
        cursor: pointer;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition:
            background var(--transition),
            color var(--transition);
    }

    .theme-switch button.is-active {
        background: var(--color-surface);
        color: var(--color-text);
        box-shadow: var(--shadow-sm);
    }

    .theme-switch button:hover:not(.is-active) {
        color: var(--color-primary);
    }

    @media (max-width: 480px) {
        .theme-switch button {
            font-size: 0.72rem;
            padding: 0.4rem 0.55rem;
            min-height: 40px;
        }
    }

    @media (max-width: 768px) {
        .logo {
            min-width: 0;
            gap: 0.5rem;
            font-size: 1rem;
        }

        .logo img {
            width: 32px;
            height: 32px;
            flex-shrink: 0;
        }

        .logo span {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
    }
</style>
