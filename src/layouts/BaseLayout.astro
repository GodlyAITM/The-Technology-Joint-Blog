---
import "../styles/global.css";
import { SITE } from "../config/site";
import { getApiBase } from "../lib/studio/github";

interface Props {
    title?: string;
    description?: string;
    canonical?: string;
    image?: string;
    noindex?: boolean;
}

const {
    title = SITE.title,
    description = SITE.description,
    canonical,
    image = SITE.defaultHero,
    noindex = false,
} = Astro.props;

const siteBase = import.meta.env.BASE_URL;
const siteBaseClean = siteBase.replace(/\/$/, "");
// getApiBase() is build-safe: it returns "" when PUBLIC_STUDIO_API_URL is
// unset, so the missing variable can never break any page build.
const studioApiBase = getApiBase();
// Simple Analytics hostname (e.g. "godlyaitm.github.io"). When set, the
// analytics script loads on every page and the Studio dashboard can fetch
// public per-article stats. Build-safe: empty string when unset.
const analyticsDomain = import.meta.env.PUBLIC_ANALYTICS_DOMAIN?.trim() || "";
const googleSiteVerification =
    import.meta.env.GOOGLE_SITE_VERIFICATION?.trim() ||
    "W-kyMHdnvxYxUUuNKa1lUe9CFY2doViJm3duZAbr32E";

const canonicalUrl = canonical
    ? new URL(canonical, SITE.url).toString()
    : Astro.url.href;

const imageUrl = new URL(image, SITE.url).toString();

const faviconUrl = `${siteBase}favicon.svg`;

const organizationSchema = {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
    logo: imageUrl,
    email: SITE.email,
    sameAs: Object.values(SITE.social).filter(Boolean),
};

const websiteSchema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    inLanguage: SITE.language,
    publisher: {
        "@type": "Organization",
        name: SITE.name,
    },
};
---

<!doctype html>
<html lang={SITE.language}>
    <head>
        <script is:inline>
            (function () {
                try {
                    // Theme is one of: "light" | "dark" | "system".
                    // Unset / "system" follows the OS preference live.
                    const stored = localStorage.getItem("theme");
                    const prefersDark =
                        window.matchMedia &&
                        window.matchMedia("(prefers-color-scheme: dark)")
                            .matches;

                    const theme =
                        stored === "light" || stored === "dark"
                            ? stored
                            : prefersDark
                              ? "dark"
                              : "light";

                    document.documentElement.setAttribute("data-theme", theme);
                    document.documentElement.setAttribute(
                        "data-theme-preference",
                        stored || "system",
                    );
                } catch (e) {
                    // Ignore theme initialization errors.
                }
            })();
        </script>

        <meta charset="UTF-8" />

        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>{title}</title>

        <meta name="description" content={description} />

        <meta name="author" content={SITE.author} />

        <meta name="theme-color" content="#2563EB" />

        <meta
            name="robots"
            content={noindex ? "noindex,nofollow" : "index,follow"}
        />

        <meta
            name="google-site-verification"
            content={googleSiteVerification}
        />

        <link rel="canonical" href={canonicalUrl} />

        <link rel="icon" href={faviconUrl} />

        <!-- Open Graph -->

        <meta property="og:type" content="website" />

        <meta property="og:site_name" content={SITE.name} />

        <meta property="og:title" content={title} />

        <meta property="og:description" content={description} />

        <meta property="og:url" content={canonicalUrl} />

        <meta property="og:image" content={imageUrl} />

        <meta property="og:locale" content="en_US" />

        <!-- Twitter -->

        <meta name="twitter:card" content="summary_large_image" />

        <meta name="twitter:title" content={title} />

        <meta name="twitter:description" content={description} />

        <meta name="twitter:image" content={imageUrl} />

        <!-- JSON-LD -->

        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(organizationSchema)}
        />

        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(websiteSchema)}
        />

        <slot name="head" />
    </head>

    <body
        data-site-base={siteBaseClean}
        data-studio-api={studioApiBase}
        data-analytics-domain={analyticsDomain}
    >
        <slot />

        <script is:inline>
            (function () {
                // NOTE: import.meta.env is NOT available inside is:inline
                // scripts (it would throw "Cannot use 'import.meta' outside a
                // module"), so the values are read from data attributes set
                // on <body> from the component frontmatter at build time.
                var body = document.body;
                var base = (body && body.getAttribute("data-site-base")) || "";
                var apiBase =
                    (body && body.getAttribute("data-studio-api")) || "";

                var path = window.location.pathname;
                var isStudioRoute = /\/studio(\/|$)/.test(path);
                var isLoginRoute = path === base + "/studio/login";

                if (!isStudioRoute) return;

                function handleAuth(authenticated) {
                    if (isLoginRoute) {
                        if (authenticated) {
                            window.location.replace(base + "/studio");
                        }
                        return;
                    }
                    if (!authenticated) {
                        window.location.replace(base + "/studio/login");
                    }
                }

                if (!apiBase) {
                    // Local-dev fallback: lightweight session stored in
                    // sessionStorage ONLY, so it is cleared when the browser/
                    // tab session ends and every visit asks to sign in again.
                    var authenticated =
                        window.sessionStorage.getItem("studio-auth") ===
                        "authenticated";
                    handleAuth(authenticated);
                    return;
                }

                // OAuth mode: ask the worker for the session (HttpOnly cookie
                // is sent automatically via credentials: include).
                fetch(apiBase + "/api/auth/session", {
                    credentials: "include",
                })
                    .then(function (res) {
                        return res.json();
                    })
                    .then(function (data) {
                        handleAuth(Boolean(data && data.authenticated));
                    })
                    .catch(function () {
                        handleAuth(false);
                    });
            })();
        </script>

        <!-- Simple Analytics - 100% privacy-first analytics -->
        {
            analyticsDomain && (
                <script
                    is:inline
                    async
                    src="https://scripts.simpleanalyticscdn.com/latest.js"
                />
            )
        }

        <script is:inline>
            (function () {
                function resolveSystem() {
                    return window.matchMedia("(prefers-color-scheme: dark)")
                        .matches
                        ? "dark"
                        : "light";
                }

                function getPreference() {
                    try {
                        return localStorage.getItem("theme") || "system";
                    } catch (e) {
                        return "system";
                    }
                }

                function applyTheme(theme) {
                    document.documentElement.setAttribute("data-theme", theme);
                }

                function syncSystem() {
                    if (getPreference() === "system") {
                        applyTheme(resolveSystem());
                    }
                }

                function updateButtons() {
                    const preference = getPreference();
                    document
                        .querySelectorAll("[data-theme-choice]")
                        .forEach((btn) => {
                            const active =
                                btn.getAttribute("data-theme-choice") ===
                                preference;
                            btn.setAttribute("aria-pressed", String(active));
                            btn.classList.toggle("is-active", active);
                        });
                }

                function initThemeControl() {
                    document.addEventListener("click", function (event) {
                        const target = event.target;
                        if (!(target instanceof Element)) return;
                        const btn = target.closest("[data-theme-choice]");
                        if (!btn) return;

                        const choice = btn.getAttribute("data-theme-choice");
                        if (
                            choice !== "light" &&
                            choice !== "dark" &&
                            choice !== "system"
                        )
                            return;

                        try {
                            if (choice === "system") {
                                localStorage.removeItem("theme");
                            } else {
                                localStorage.setItem("theme", choice);
                            }
                        } catch (e) {
                            // Ignore storage errors.
                        }

                        document.documentElement.setAttribute(
                            "data-theme-preference",
                            choice,
                        );
                        if (choice === "system") {
                            applyTheme(resolveSystem());
                        } else {
                            applyTheme(choice);
                        }
                        updateButtons();
                    });

                    // Follow OS theme changes live while in "system" mode
                    if (window.matchMedia) {
                        window
                            .matchMedia("(prefers-color-scheme: dark)")
                            .addEventListener("change", syncSystem);
                    }

                    syncSystem();
                    updateButtons();
                }

                if (document.readyState === "loading") {
                    document.addEventListener(
                        "DOMContentLoaded",
                        initThemeControl,
                    );
                } else {
                    initThemeControl();
                }
            })();
        </script>
    </body>
</html>
