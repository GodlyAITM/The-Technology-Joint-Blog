---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAuthMode } from "../../lib/studio/github";

// Build-safe: getAuthMode() returns "pat" when PUBLIC_STUDIO_API_URL is
// unset, so the missing variable can never break the build or the login page.
const authMode = getAuthMode();
---

<BaseLayout
    title="Studio Login | The Technology Joint"
    description="Sign in to the private Studio workspace."
>
    <section class="login-shell">
        <div class="login-card">
            <p class="studio-eyebrow">Private access</p>
            <h1>Welcome to The Technology Joint Studio</h1>

            {
                authMode === "oauth" ? (
                    <div id="login-oauth" class="login-oauth">
                        <a class="github-button" href="#" id="github-login-btn">
                            <svg
                                viewBox="0 0 24 24"
                                width="20"
                                height="20"
                                fill="currentColor"
                                aria-hidden="true"
                            >
                                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                            </svg>
                            Log in with GitHub
                        </a>
                        <p class="login-hint">
                            Sign in with GitHub to manage articles on the live
                            site. You'll be redirected to GitHub to authorize
                            the Studio app, and your session is stored in a
                            secure cookie.
                        </p>
                        <div id="login-status" class="login-status" aria-live="polite">
                            Click above to sign in with GitHub.
                        </div>
                    </div>
                ) : authMode === "team" ? (
                    <div id="login-team" class="login-oauth">
                        <form id="team-signin-form" class="login-form" data-team-form="signin">
                            <div class="login-field">
                                <label for="team-username">Username</label>
                                <input
                                    id="team-username"
                                    name="username"
                                    type="text"
                                    autocomplete="username"
                                    placeholder="yourstudioalias"
                                    autocapitalize="none"
                                    spellcheck="false"
                                    required
                                />
                            </div>
                            <div class="login-field">
                                <label for="team-password">Password</label>
                                <div class="login-field__toggle">
                                    <input
                                        id="team-password"
                                        name="password"
                                        type="password"
                                        autocomplete="current-password"
                                        minlength="8"
                                        required
                                    />
                                    <button type="button" class="login-toggle-pw" aria-label="Show password" data-pw-toggle="team-password">
                                        <svg class="pw-icon-show" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        <svg class="pw-icon-hide" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                                    </button>
                                </div>
                            </div>
                            <button class="login-submit" type="submit">
                                Sign in to Studio
                            </button>
                        </form>

                        <p class="login-hint" id="team-hint">
                            Your editor account uses the site's shared
                            publishing token — no GitHub account needed.
                            New accounts are created by the site owner.
                        </p>
                        <div id="login-status" class="login-status" aria-live="polite"></div>
                    </div>
                ) : (
                    <div id="login-local" class="login-oauth">
                        <p class="login-note">
                            <strong>The Studio runs on this site</strong> — no
                            separate server or API needed. Publishing commits
                            straight to GitHub using the personal access token
                            you save in Studio → Settings.
                        </p>
                        <form id="studio-login-form" class="login-form">
                            <button type="submit" class="login-submit">
                                Enter Studio
                            </button>
                        </form>
                        <div id="login-status" class="login-status" aria-live="polite">
                            Click above to enter the Studio workspace.
                        </div>
                    </div>
                )
            }
        </div>
    </section>
</BaseLayout>

<script>
    import {
        getApiBase,
        getAuthMode,
        teamLogin,
    } from "../../lib/studio/github";

    const apiBase = getApiBase();
    const authMode = getAuthMode();
    const base = import.meta.env.BASE_URL.replace(/\/$/, "");
    const status = document.getElementById("login-status");

    // Password show/hide toggle
    document.querySelectorAll<HTMLElement>("[data-pw-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
            const input = document.getElementById(btn.dataset.pwToggle || "");
            if (!input) return;
            const isPassword = input.getAttribute("type") === "password";
            input.setAttribute("type", isPassword ? "text" : "password");
            btn.setAttribute("aria-label", isPassword ? "Hide password" : "Show password");
            const showIcon = btn.querySelector(".pw-icon-show");
            const hideIcon = btn.querySelector(".pw-icon-hide");
            if (showIcon) (showIcon as HTMLElement).style.display = isPassword ? "none" : "";
            if (hideIcon) (hideIcon as HTMLElement).style.display = isPassword ? "" : "none";
        });
    });

    // Resolve where to go after a successful sign-in, preserving deep
    // links (e.g. /studio/editor?slug=...) passed as ?next=. Only same
    // origin targets are accepted — an external ?next= (open redirect)
    // falls back to the Studio dashboard.
    function safeNext(value: string | null): string {
        if (!value) return `${base}/studio`;
        try {
            const target = new URL(value, window.location.origin);
            if (target.origin === window.location.origin) {
                return target.toString();
            }
        } catch {
            // fall through to the default
        }
        return `${base}/studio`;
    }
    const next = safeNext(
        new URLSearchParams(window.location.search).get("next"),
    );

    function setStatus(message: string, kind: "info" | "error" = "info") {
        if (!status) return;
        status.className = "login-status";
        if (kind === "error") status.classList.add("login-status--error");
        status.textContent = message;
    }

    if (authMode === "oauth") {
        const link = document.querySelector<HTMLAnchorElement>(".github-button");
        if (link && status) {
            const loginUrl = new URL("/api/auth/login", apiBase!);
            loginUrl.searchParams.set("next", next);
            link.href = loginUrl.toString();
            status.textContent = "Ready — click to sign in with GitHub.";
            // Prevent double-clicks: after first click, grey out the button
            // so the user doesn't fire multiple OAuth redirects.
            let clicked = false;
            link.addEventListener("click", () => {
                if (clicked) {
                    status.textContent = "Redirecting to GitHub… please wait.";
                    return;
                }
                clicked = true;
                link.style.opacity = "0.6";
                link.style.pointerEvents = "none";
                status.textContent = "Redirecting to GitHub…";
            });
        }
    } else if (authMode === "team") {
        function setLoading(form: HTMLFormElement, loading: boolean) {
            const btn = form.querySelector<HTMLButtonElement>(".login-submit");
            if (btn) {
                btn.disabled = loading;
                btn.textContent = loading ? "Please wait…" : "Sign in to Studio";
            }
        }

        const signin = document.getElementById(
            "team-signin-form",
        ) as HTMLFormElement | null;
        signin?.addEventListener("submit", async (event) => {
            event.preventDefault();
            const data = new FormData(signin);
            const username = String(data.get("username") || "").trim();
            const password = String(data.get("password") || "");
            if (!username || !password) {
                setStatus("Please enter both username and password.", "error");
                return;
            }
            setLoading(signin, true);
            setStatus("Signing in…");
            const result = await teamLogin(username, password);
            if (!result.ok) {
                setLoading(signin, false);
                setStatus(result.error || "Sign in failed.", "error");
                return;
            }
            setStatus("Signed in — redirecting…");
            window.location.assign(next);
        });
    } else {
        const form = document.getElementById(
            "studio-login-form",
        ) as HTMLFormElement | null;
        if (form && status) {
            form.addEventListener("submit", (event) => {
                event.preventDefault();
                const btn = form.querySelector<HTMLButtonElement>(".login-submit");
                if (btn) {
                    btn.disabled = true;
                    btn.textContent = "Entering Studio…";
                }
                setStatus("Redirecting to the Studio…");
                // sessionStorage only — cleared when the browser/tab session
                // ends, so every fresh visit asks to sign in again.
                window.sessionStorage.setItem("studio-auth", "authenticated");
                window.location.assign(`${base}/studio`);
            });
        }
    }
</script>

<style>
    .login-shell {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem 1rem;
        background: var(--gradient-surface);
    }

    .login-card {
        width: min(100%, 440px);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
        padding: 2.5rem 2.25rem;
        box-shadow: var(--shadow-xl);
    }

    .studio-eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 0.68rem;
        color: var(--color-primary);
        margin: 0 0 0.5rem;
        font-weight: 600;
    }

    .login-card h1 {
        margin: 0 0 1.5rem;
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        line-height: 1.3;
    }

    .login-oauth {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
    }

    .github-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        min-height: 48px;
        padding: 0.85rem 1.25rem;
        border-radius: var(--radius-sm);
        background: var(--color-text);
        color: var(--color-background);
        font-weight: 700;
        text-decoration: none;
        transition:
            opacity var(--transition-fast),
            transform var(--transition-fast),
            box-shadow var(--transition-fast);
        box-shadow: var(--shadow-md);
    }

    .github-button:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        box-shadow: var(--shadow-lg);
    }

    .login-hint {
        font-size: 0.85rem;
        color: var(--color-muted);
        line-height: 1.55;
        margin: 0;
    }

    .login-status {
        color: var(--color-muted);
        font-size: 0.88rem;
    }

    .login-status--error {
        color: var(--color-danger);
        font-weight: 600;
    }

    .login-note {
        font-size: 0.88rem;
        line-height: 1.55;
        padding: 0.85rem 1rem;
        border-radius: var(--radius-md);
        background: color-mix(
            in srgb,
            var(--color-primary) 8%,
            var(--color-surface)
        );
        border: 1px solid color-mix(
            in srgb, var(--color-primary) 20%, var(--color-border)
        );
    }

    /* ---- Team mode tabs + forms ---- */

    .login-tabs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.35rem;
        padding: 0.35rem;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        background: var(--color-surface-alt);
    }

    .login-tab {
        border: 0;
        background: transparent;
        color: var(--color-muted);
        font: inherit;
        font-weight: 600;
        font-size: 0.92rem;
        padding: 0.6rem 0.75rem;
        border-radius: 999px;
        cursor: pointer;
        min-height: 42px;
        transition:
            background var(--transition),
            color var(--transition);
    }

    .login-tab.is-active {
        background: var(--color-surface);
        color: var(--color-text);
        box-shadow: var(--shadow-sm);
    }

    .login-tab:hover:not(.is-active) {
        color: var(--color-primary);
    }

    .login-form {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        margin-top: 0.25rem;
    }

    .login-field {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .login-field label {
        font-weight: 600;
        font-size: 0.88rem;
        color: var(--color-text);
    }

    .login-field input {
        width: 100%;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        padding: 0.75rem 0.9rem;
        font: inherit;
        background: var(--color-background);
        color: var(--color-text);
        transition:
            border-color var(--transition-fast),
            box-shadow var(--transition-fast);
        font-size: 0.92rem;
    }

    .login-field input:focus {
        outline: none;
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px
            color-mix(in srgb, var(--color-primary) 15%, transparent);
    }

    .login-submit {
        border: 0;
        border-radius: var(--radius-sm);
        background: var(--color-primary);
        color: var(--color-on-primary);
        padding: 0.85rem 1rem;
        font: inherit;
        font-weight: 700;
        font-size: 0.92rem;
        cursor: pointer;
        min-height: 48px;
        transition:
            background var(--transition-fast),
            transform var(--transition-fast),
            box-shadow var(--transition-fast);
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.2);
        margin-top: 0.25rem;
    }

    .login-submit:hover:not(:disabled) {
        background: var(--color-primary-dark);
        transform: translateY(-1px);
        box-shadow: 0 4px 16px rgba(37, 99, 235, 0.25);
    }

    .login-submit:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    @media (max-width: 480px) {
        .login-card {
            padding: 1.75rem 1.5rem;
        }
    }
</style>
