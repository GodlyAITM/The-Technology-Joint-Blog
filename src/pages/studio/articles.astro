---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StudioShell from "../../components/studio/StudioShell.astro";
import { getArticleStatus } from "../../lib/articles";

const posts = (await getCollection("articles"))
    .slice()
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .map((post) => ({
        title: post.data.title,
        category: post.data.category,
        tags: post.data.tags,
        status: getArticleStatus(post),
        pubDate: post.data.pubDate.toISOString(),
        scheduledLabel: post.data.pubDate.toLocaleString("en-US", {
            month: "short",
            day: "numeric",
            year: "numeric",
            hour: "numeric",
            minute: "2-digit",
        }),
        featured: post.data.featured,
        updated:
            post.data.updatedDate?.toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
                year: "numeric",
            }) ||
            post.data.pubDate.toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
                year: "numeric",
            }),
        slug: post.id,
    }));

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
    title="Studio Articles | The Technology Joint"
    description="Manage stories from the private Studio workspace."
    noindex
>
    <StudioShell active="articles">
        <header class="studio-header">
            <div>
                <p class="studio-eyebrow">Content operations</p>
                <h2>Article manager</h2>
                <p class="studio-lead">
                    Browse, edit and duplicate existing stories — or start a
                    new one.
                </p>
            </div>
            <a class="studio-button" href={`${base}/studio/editor`}
                >New article</a
            >
        </header>

        <section class="studio-panel">
            <div class="studio-panel__header">
                <h3 id="article-count">All articles ({posts.length})</h3>
            </div>

            <div class="studio-filterbar">
                <div class="studio-search">
                    <span class="studio-search__icon" aria-hidden="true">
                        <svg
                            viewBox="0 0 24 24"
                            width="16"
                            height="16"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                        >
                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="m21 21-4.35-4.35"></path>
                        </svg>
                    </span>
                    <input
                        id="article-search"
                        type="search"
                        placeholder="Search by title, category or tag…"
                        autocomplete="off"
                    />
                </div>
                <div class="studio-filter" role="group" aria-label="Filter by status">
                    <button type="button" data-filter="all" class="is-active">
                        All
                    </button>
                    <button type="button" data-filter="published">
                        Published
                    </button>
                    <button type="button" data-filter="scheduled">
                        Scheduled
                    </button>
                    <button type="button" data-filter="draft">Drafts</button>
                    <button type="button" data-filter="archived">
                        Archived
                    </button>
                </div>
            </div>

            {
                posts.length > 0 ? (
                    <table class="studio-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Updated</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                posts.map((post) => (
                                    <tr
                                        data-status={post.status}
                                        data-search={`${post.title} ${post.category} ${post.tags.join(" ")}`.toLowerCase()}
                                    >
                                        <td>
                                            <div class="studio-table__title">
                                                {post.title}
                                            </div>
                                        </td>
                                        <td data-label="Category">
                                            {post.category}
                                        </td>
                                        <td data-label="Status">
                                            <span
                                                class:list={[
                                                    "studio-badge",
                                                    post.status === "draft"
                                                        ? "studio-badge--draft"
                                                        : post.status ===
                                                            "scheduled"
                                                          ? "studio-badge--scheduled"
                                                          : post.status ===
                                                              "archived"
                                                            ? "studio-badge--archived"
                                                            : "studio-badge--published",
                                                ]}
                                                data-status={post.status}
                                                data-pubdate={post.pubDate}
                                                title={
                                                    post.status ===
                                                    "scheduled"
                                                        ? `Scheduled for ${post.scheduledLabel}`
                                                        : undefined
                                                }
                                            >
                                                {post.status === "draft"
                                                    ? "Draft"
                                                    : post.status ===
                                                        "scheduled"
                                                      ? "Scheduled"
                                                      : post.status ===
                                                          "archived"
                                                        ? "Archived"
                                                        : "Published"}
                                            </span>
                                            {
                                                post.featured && (
                                                    <span
                                                        class="studio-badge studio-badge--featured"
                                                        title="Featured in Editor's Picks"
                                                    >
                                                        Featured
                                                    </span>
                                                )
                                            }
                                        </td>
                                        <td data-label="Updated">
                                            {post.updated}
                                        </td>
                                        <td data-label="Actions">
                                            <div class="studio-table__actions">
                                                <a
                                                    class="studio-link"
                                                    href={`${base}/studio/editor?slug=${post.slug}`}
                                                >
                                                    Edit
                                                </a>
                                                <a
                                                    class="studio-link"
                                                    href={`${base}/studio/editor?slug=${post.slug}&duplicate=1`}
                                                >
                                                    Duplicate
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                    <p
                        class="studio-table__empty"
                        id="article-empty"
                        hidden
                    >
                        No articles match your search.
                    </p>
                ) : (
                    <p class="studio-lead">
                        No articles yet. Create your first article to get
                        started.
                    </p>
                )
            }
        </section>
    </StudioShell>
</BaseLayout>

<script>
    // Keep Draft / Scheduled / Published badges accurate against the current
    // time: a scheduled article flips to "Published" the moment its pubDate
    // passes, without waiting for a rebuild.
    const BADGE_LABELS: Record<string, string> = {
        draft: "Draft",
        scheduled: "Scheduled",
        published: "Published",
        archived: "Archived",
    };
    const BADGE_CLASSES: Record<string, string> = {
        draft: "studio-badge--draft",
        scheduled: "studio-badge--scheduled",
        published: "studio-badge--published",
        archived: "studio-badge--archived",
    };
    const now = Date.now();
    document
        .querySelectorAll("[data-status][data-pubdate]")
        .forEach((el) => {
            const isDraft = el.getAttribute("data-status") === "draft";
            const isArchived = el.getAttribute("data-status") === "archived";
            const pubDate = Number(
                new Date(el.getAttribute("data-pubdate") || ""),
            );
            const status = isDraft
                ? "draft"
                : isArchived
                  ? "archived"
                  : pubDate > now
                    ? "scheduled"
                    : "published";
            el.classList.remove(
                "studio-badge--draft",
                "studio-badge--scheduled",
                "studio-badge--published",
                "studio-badge--archived",
            );
            el.classList.add(BADGE_CLASSES[status]);
            el.textContent = BADGE_LABELS[status];
            el.setAttribute("data-status", status);
            // Keep the parent row's status in sync for the status filter.
            el.closest("tr")?.setAttribute("data-status", status);
            // A flipped badge must not keep the "Scheduled for …" tooltip
            if (status !== "scheduled") el.removeAttribute("title");
        });
</script>

<script>
    // Client-side search + status filter for the article manager.
    const searchInput = document.getElementById(
        "article-search",
    ) as HTMLInputElement | null;
    const filterButtons =
        document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const countEl = document.getElementById("article-count");
    const emptyEl = document.getElementById("article-empty");
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>(
        ".studio-table tbody tr",
    ));
    let activeFilter = "all";

    function applyFilters() {
        const query = (searchInput?.value || "").trim().toLowerCase();
        let visible = 0;

        rows.forEach((row) => {
            const status = row.getAttribute("data-status") || "";
            const haystack = row.getAttribute("data-search") || "";
            const matchesFilter =
                activeFilter === "all" || status === activeFilter;
            const matchesQuery = !query || haystack.includes(query);
            const show = matchesFilter && matchesQuery;
            row.hidden = !show;
            if (show) visible++;
        });

        if (countEl) {
            countEl.textContent = `All articles (${visible})`;
        }
        if (emptyEl) {
            emptyEl.hidden = visible > 0;
        }
    }

    searchInput?.addEventListener("input", applyFilters);

    filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
            activeFilter = button.dataset.filter || "all";
            filterButtons.forEach((b) =>
                b.classList.toggle("is-active", b === button),
            );
            applyFilters();
        });
    });
</script>
