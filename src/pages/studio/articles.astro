---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StudioShell from "../../components/studio/StudioShell.astro";

const posts = (await getCollection("articles"))
    .slice()
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .map((post) => ({
        title: post.data.title,
        category: post.data.category,
        status: post.data.draft ? "draft" : "published",
        featured: post.data.featured,
        updated:
            post.data.updatedDate?.toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
                year: "numeric",
            }) ||
            post.data.pubDate.toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
                year: "numeric",
            }),
        slug: post.id,
    }));

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
    title="Studio Articles | The Technology Joint"
    description="Manage stories from the private Studio workspace."
    noindex
>
    <StudioShell active="articles">
        <header class="studio-header">
            <div>
                <p class="studio-eyebrow">Content operations</p>
                <h2>Article manager</h2>
                <p class="studio-lead">
                    Browse, edit and duplicate existing stories — or start a
                    new one.
                </p>
            </div>
            <a class="studio-button" href={`${base}/studio/editor`}
                >New article</a
            >
        </header>

        <section class="studio-panel">
            <div class="studio-panel__header">
                <h3>All articles ({posts.length})</h3>
            </div>

            {
                posts.length > 0 ? (
                    <table class="studio-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Updated</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                posts.map((post) => (
                                    <tr>
                                        <td>
                                            <div class="studio-table__title">
                                                {post.title}
                                            </div>
                                        </td>
                                        <td data-label="Category">
                                            {post.category}
                                        </td>
                                        <td data-label="Status">
                                            <span
                                                class:list={[
                                                    "studio-badge",
                                                    post.status === "draft"
                                                        ? "studio-badge--draft"
                                                        : "studio-badge--published",
                                                ]}
                                            >
                                                {post.status === "draft"
                                                    ? "Draft"
                                                    : "Published"}
                                            </span>
                                            {
                                                post.featured && (
                                                    <span
                                                        class="studio-badge studio-badge--featured"
                                                        title="Featured in Editor's Picks"
                                                    >
                                                        Featured
                                                    </span>
                                                )
                                            }
                                        </td>
                                        <td data-label="Updated">
                                            {post.updated}
                                        </td>
                                        <td data-label="Actions">
                                            <div class="studio-table__actions">
                                                <a
                                                    class="studio-link"
                                                    href={`${base}/studio/editor?slug=${post.slug}`}
                                                >
                                                    Edit
                                                </a>
                                                <a
                                                    class="studio-link"
                                                    href={`${base}/studio/editor?slug=${post.slug}&duplicate=1`}
                                                >
                                                    Duplicate
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                ) : (
                    <p class="studio-lead">
                        No articles yet. Create your first article to get
                        started.
                    </p>
                )
            }
        </section>
    </StudioShell>
</BaseLayout>
