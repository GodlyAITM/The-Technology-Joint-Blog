---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StudioShell from "../../components/studio/StudioShell.astro";
import { getAllAuthors } from "../../lib/author";

// NOTE: Astro.url.searchParams is empty at build time for static pages.
// The slug is read client-side from window.location at runtime.
const slug = "";
const isDuplicate = false;
const posts = await getCollection("articles");
const sourcePost = posts.find((post) => post.id === slug) ?? null;

const authors = getAllAuthors();
const categories = [
    ...new Set(posts.map((post) => post.data.category).filter(Boolean)),
].sort();

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// pubDate supports time-of-day (scheduling), formatted for <input
// type="datetime-local"> in the visitor's local timezone.
function toDateTimeLocal(d: Date): string {
    const pad = (n: number) => String(n).padStart(2, "0");
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

const isEditing = Boolean(sourcePost) && !isDuplicate;

const article = sourcePost
    ? {
          slug: sourcePost.id,
          title: sourcePost.data.title,
          description: sourcePost.data.description,
          pubDate: toDateTimeLocal(sourcePost.data.pubDate),
          updatedDate:
              sourcePost.data.updatedDate?.toISOString().slice(0, 10) || "",
          author: sourcePost.data.author,
          category: sourcePost.data.category,
          tags: sourcePost.data.tags.join(", "),
          featured: sourcePost.data.featured,
          draft: isDuplicate ? true : sourcePost.data.draft,
          archived: isDuplicate ? false : sourcePost.data.archived === true,
          heroImage: isDuplicate ? "" : sourcePost.data.heroImage || "",
          featuredImageAlt: isDuplicate
              ? ""
              : sourcePost.data.featuredImageAlt || "",
          seoTitle: sourcePost.data.seoTitle || "",
          seoDescription: sourcePost.data.seoDescription || "",
          canonicalURL: sourcePost.data.canonicalURL || "",
          body: sourcePost.body,
      }
    : {
          slug: "",
          title: "",
          description: "",
          pubDate: toDateTimeLocal(new Date()),
          updatedDate: "",
          author: authors[0]?.name ?? "Israel Alabi",
          category: "",
          tags: "",
          featured: false,
          draft: true,
          archived: false,
          heroImage: "",
          featuredImageAlt: "",
          seoTitle: "",
          seoDescription: "",
          canonicalURL: "",
          body: "",
      };

const newSlugDefault =
    isDuplicate && sourcePost ? `${sourcePost.id}-copy` : "";

const authorOptions = [...new Set([...authors.map((a) => a.name), article.author])];

const previewUrl =
    isEditing && sourcePost && !sourcePost.data.draft
        ? `${base}/articles/${sourcePost.id}/`
        : null;

const allSlugs = posts.map((post) => post.id);
---

<BaseLayout
    title="Studio Editor | The Technology Joint"
    description="Edit existing articles from the private Studio workspace."
    noindex
>
    <StudioShell active="editor">
        <header class="studio-header">
            <div>
                <p class="studio-eyebrow">Content editor</p>
                <h2>
                    {isEditing
                        ? "Edit article"
                        : isDuplicate
                          ? "Duplicate article"
                          : "Create article"}
                </h2>
            </div>
            <a
                class="studio-button studio-button--secondary"
                href={`${base}/studio/articles`}
                >Back to list</a
            >
        </header>

        <form
            id="studio-editor-form"
            class="studio-form"
            data-editing={isEditing ? "true" : "false"}
            data-original-slug={article.slug}
            data-slugs={JSON.stringify(allSlugs)}
        >
            <!-- ==================== 1. Article details ==================== -->
            <section class="studio-form-section">
                <div class="studio-form-section__header">
                    <h3>Article details</h3>
                    <p>
                        Title, description, dates and taxonomies shown across
                        the site.
                    </p>
                </div>

                {
                    !isEditing && (
                        <div class="studio-field">
                            <label for="field-slug">
                                Slug (URL)
                                <span class="studio-field__required">*</span>
                            </label>
                            <input
                                id="field-slug"
                                name="slug"
                                type="text"
                                value={newSlugDefault}
                                placeholder="e.g. best-password-managers-2026"
                                autocomplete="off"
                            />
                            <p class="studio-hint">
                                Used for the file name and article URL. Lowercase
                                letters, numbers and dashes only. Auto-fills from
                                the title.
                            </p>
                        </div>
                    )
                }

                <div class="studio-field">
                    <label for="field-title">
                        Title
                        <span class="studio-field__required">*</span>
                    </label>
                    <input
                        id="field-title"
                        name="title"
                        type="text"
                        value={article.title}
                        placeholder="Article headline"
                        autocomplete="off"
                    />
                </div>

                <div class="studio-field">
                    <label for="field-description">
                        Description
                        <span class="studio-field__required">*</span>
                    </label>
                    <textarea
                        id="field-description"
                        name="description"
                        rows="3"
                        placeholder="Short summary shown on cards, listing pages and search results."
                    >{article.description}</textarea>
                </div>

                <div class="studio-field-row">
                    <div class="studio-field">
                        <label for="field-pubdate">
                            Published date
                            <span class="studio-field__required">*</span>
                        </label>
                        <input
                            id="field-pubdate"
                            name="pubDate"
                            type="datetime-local"
                            value={article.pubDate}
                        />
                        <p class="studio-hint">
                            Set a future date/time to schedule this article. It
                            goes live automatically after the next scheduled
                            site rebuild passes this moment.
                        </p>
                    </div>
                    <div class="studio-field">
                        <label for="field-updated">
                            Updated date
                            <span class="studio-hint">(optional)</span>
                        </label>
                        <input
                            id="field-updated"
                            name="updatedDate"
                            type="date"
                            value={article.updatedDate}
                        />
                    </div>
                </div>

                <div class="studio-field-row">
                    <div class="studio-field">
                        <label for="field-author">
                            Author
                            <span class="studio-field__required">*</span>
                        </label>
                        <select id="field-author" name="author">
                            {
                                authorOptions.map((name) => (
                                    <option
                                        value={name}
                                        selected={name === article.author}
                                    >
                                        {name}
                                    </option>
                                ))
                            }
                        </select>
                    </div>
                    <div class="studio-field">
                        <label for="field-category">
                            Category
                            <span class="studio-field__required">*</span>
                        </label>
                        <input
                            id="field-category"
                            name="category"
                            type="text"
                            value={article.category}
                            list="studio-categories"
                            placeholder="e.g. Cybersecurity"
                            autocomplete="off"
                        />
                        <datalist id="studio-categories">
                            {
                                categories.map((category) => (
                                    <option value={category} />
                                ))
                            }
                        </datalist>
                    </div>
                </div>

                <div class="studio-field">
                    <label for="field-tags">Tags (comma separated)</label>
                    <input
                        id="field-tags"
                        name="tags"
                        type="text"
                        value={article.tags}
                        placeholder="Password Managers, Security, Privacy"
                        autocomplete="off"
                    />
                </div>

                <div class="studio-checkbox-row">
                    <label class="studio-checkbox">
                        <input
                            name="featured"
                            type="checkbox"
                            checked={article.featured}
                        />
                        <span>
                            <strong>Featured</strong>
                            <small>
                                Featured articles appear in the Editor's Picks
                                section on the homepage.
                            </small>
                        </span>
                    </label>
                    <label class="studio-checkbox">
                        <input
                            name="draft"
                            type="checkbox"
                            checked={article.draft}
                        />
                        <span>
                            <strong>Draft</strong>
                            <small>
                                Drafts are excluded from the published site.
                                New articles always start as drafts; "Publish
                                now" always clears this.
                            </small>
                        </span>
                    </label>
                    <label class="studio-checkbox">
                        <input
                            name="archived"
                            type="checkbox"
                            checked={article.archived}
                        />
                        <span>
                            <strong>Archived</strong>
                            <small>
                                Archived articles are hidden from the public
                                site but kept in the Studio. "Publish now"
                                always un-archives.
                            </small>
                        </span>
                    </label>
                </div>
            </section>

            <!-- ==================== 2. Hero image ==================== -->
            <section class="studio-form-section">
                <div class="studio-form-section__header">
                    <h3>Hero image</h3>
                    <p>
                        Upload the article's main image, then describe it — the
                        two go together.
                    </p>
                </div>

                <div class="studio-field">
                    <label class="studio-field__label">Hero image</label>
                    <div class="studio-file-input">
                        <input
                            id="field-heroimage"
                            type="file"
                            accept="image/png,image/jpeg,image/webp,image/gif"
                        />
                        <button
                            class="studio-button studio-button--secondary studio-button--sm"
                            type="button"
                            id="remove-hero-image"
                            hidden
                        >
                            Remove image
                        </button>
                    </div>
                    <input type="hidden" name="heroImage" value={article.heroImage} />
                    <figure class="studio-image-preview" id="hero-image-preview" hidden>
                        <img id="hero-image-preview-img" alt="Hero image preview" />
                        <figcaption id="hero-image-caption"></figcaption>
                    </figure>
                    <p class="studio-hint" id="hero-image-hint">
                        Saved to public/images/articles/ and committed with your
                        article.
                    </p>
                </div>

                <div class="studio-field">
                    <label for="field-alt">
                        Hero image alt text
                        <span class="studio-hint">(recommended)</span>
                    </label>
                    <input
                        id="field-alt"
                        name="featuredImageAlt"
                        type="text"
                        value={article.featuredImageAlt}
                        placeholder="Describe the image for accessibility and SEO"
                        autocomplete="off"
                    />
                </div>
            </section>

            <!-- ==================== 3. SEO / Meta ==================== -->
            <section class="studio-form-section">
                <div class="studio-form-section__header">
                    <h3>SEO / Meta</h3>
                    <p>
                        Optional overrides for how this article appears in
                        search results.
                    </p>
                </div>

                <div class="studio-field">
                    <label for="field-seotitle">SEO title</label>
                    <input
                        id="field-seotitle"
                        name="seoTitle"
                        type="text"
                        value={article.seoTitle}
                        placeholder="Overrides the title shown in search results"
                        autocomplete="off"
                    />
                </div>

                <div class="studio-field">
                    <label for="field-seodesc">SEO description</label>
                    <textarea
                        id="field-seodesc"
                        name="seoDescription"
                        rows="3"
                        placeholder="Overrides the meta description shown in search results"
                    >{article.seoDescription}</textarea>
                </div>

                <div class="studio-field">
                    <label for="field-canonical">Canonical URL</label>
                    <input
                        id="field-canonical"
                        name="canonicalURL"
                        type="url"
                        value={article.canonicalURL}
                        placeholder="https://… if different from the auto-generated URL"
                        autocomplete="off"
                    />
                </div>
            </section>

            <!-- ==================== 3b. SEO Analysis (live) ==================== -->
            <section class="studio-form-section" id="seo-analysis">
                <div class="studio-form-section__header">
                    <h3>SEO Analysis</h3>
                    <p>Live checklist — items turn green as you optimise.</p>
                </div>

                <!-- Meta length indicators -->
                <div class="seo-checklist" id="seo-checklist">
                    <div class="seo-check" data-seo="title-length">
                        <span class="seo-check__icon" aria-hidden="true"></span>
                        <div class="seo-check__body">
                            <strong>Title length</strong>
                            <p><span id="seo-title-count">0</span> / 60 characters — aim for 50–60 for full display in search results.</p>
                        </div>
                    </div>
                    <div class="seo-check" data-seo="desc-length">
                        <span class="seo-check__icon" aria-hidden="true"></span>
                        <div class="seo-check__body">
                            <strong>Description length</strong>
                            <p><span id="seo-desc-count">0</span> / 160 characters — aim for 150–160 for a complete snippet.</p>
                        </div>
                    </div>
                    <div class="seo-check" data-seo="alt-text">
                        <span class="seo-check__icon" aria-hidden="true"></span>
                        <div class="seo-check__body">
                            <strong>Hero image alt text</strong>
                            <p id="seo-alt-text-hint">Add descriptive alt text for accessibility and image search.</p>
                        </div>
                    </div>
                    <div class="seo-check" data-seo="body-length">
                        <span class="seo-check__icon" aria-hidden="true"></span>
                        <div class="seo-check__body">
                            <strong>Body word count</strong>
                            <p><span id="seo-body-words">0</span> words — aim for 300+ for better ranking.</p>
                        </div>
                    </div>
                    <div class="seo-check" data-seo="slug">
                        <span class="seo-check__icon" aria-hidden="true"></span>
                        <div class="seo-check__body">
                            <strong>URL slug</strong>
                            <p id="seo-slug-hint">Use a short, descriptive slug with your main keyword.</p>
                        </div>
                    </div>
                    <div class="seo-check" data-seo="category">
                        <span class="seo-check__icon" aria-hidden="true"></span>
                        <div class="seo-check__body">
                            <strong>Category set</strong>
                            <p id="seo-category-hint">Assign a category so articles are grouped correctly.</p>
                        </div>
                    </div>
                </div>

                <!-- Open Graph preview -->
                <div class="studio-panel__header" style="margin-top: 1rem">
                    <h3>Social preview</h3>
                </div>
                <div class="seo-og-preview" id="seo-og-preview">
                    <div class="seo-og-preview__image" id="seo-og-image">
                        <span id="seo-og-image-hint">No hero image set</span>
                    </div>
                    <div class="seo-og-preview__body">
                        <span class="seo-og-preview__site" id="seo-og-site">The Technology Joint</span>
                        <strong class="seo-og-preview__title" id="seo-og-title">Article title</strong>
                        <p class="seo-og-preview__desc" id="seo-og-desc">Article description will appear here.</p>
                    </div>
                </div>
            </section>

            <!-- ==================== 4. Content ==================== -->
            <section class="studio-form-section">
                <div class="studio-form-section__header">
                    <h3>Content</h3>
                    <p>Markdown body — the article itself.</p>
                    <div
                        class="studio-view-toggle"
                        role="group"
                        aria-label="Editor view"
                    >
                        <button
                            type="button"
                            data-view="write"
                            class="is-active"
                        >
                            Write
                        </button>
                        <button type="button" data-view="split">Split</button>
                        <button type="button" data-view="preview">
                            Preview
                        </button>
                    </div>
                </div>

                <div class="studio-field">
                    <div
                        class="studio-editor-toolbar"
                        role="toolbar"
                        aria-label="Markdown formatting"
                    >
                        <button
                            type="button"
                            class="studio-toolbar-btn"
                            data-md="bold"
                            title="Bold (Ctrl+B)"
                        >
                            <strong>B</strong>
                        </button>
                        <button
                            type="button"
                            class="studio-toolbar-btn"
                            data-md="italic"
                            title="Italic (Ctrl+I)"
                        >
                            <em>I</em>
                        </button>
                        <button
                            type="button"
                            class="studio-toolbar-btn"
                            data-md="code"
                            title="Inline code (Ctrl+E)"
                        >
                            &lt;/&gt;
                        </button>
                        <span class="studio-toolbar-sep" aria-hidden="true"></span>
                        <button
                            type="button"
                            class="studio-toolbar-btn"
                            data-md="link"
                            title="Link (Ctrl+K)"
                        >
                            🔗
                        </button>
                        <button
                            type="button"
                            class="studio-toolbar-btn"
                            data-md="image"
                            title="Image"
                        >
                            🖼
                        </button>
                        <span class="studio-toolbar-sep" aria-hidden="true"></span>
                        <button
                            type="button"
                            class="studio-toolbar-btn"
                            data-md="h2"
                            title="Heading"
                        >
                            H2
                        </button>
                        <button
                            type="button"
                            class="studio-toolbar-btn"
                            data-md="list"
                            title="Bullet list"
                        >
                            • List
                        </button>
                        <button
                            type="button"
                            class="studio-toolbar-btn"
                            data-md="quote"
                            title="Quote"
                        >
                            ❝
                        </button>
                        <button
                            type="button"
                            class="studio-toolbar-btn"
                            data-md="hr"
                            title="Horizontal rule"
                        >
                            —
                        </button>
                        <span class="studio-toolbar-hint">
                            Ctrl+S saves · Ctrl+Shift+S publishes
                        </span>
                    </div>

                    <div
                        class="studio-editor-grid"
                        id="editor-grid"
                        data-view="write"
                    >
                        <textarea
                            id="field-body"
                            name="body"
                            rows="20"
                            class="studio-body-textarea"
                            placeholder="Write your article in Markdown…"
                        >{article.body}</textarea>
                        <div
                            class="studio-preview"
                            id="body-preview"
                            aria-label="Live preview"
                        >
                            <p class="studio-preview__empty">
                                Your preview will appear here as you type…
                            </p>
                        </div>
                    </div>

                    <div
                        class="studio-wordcount"
                        id="wordcount"
                        aria-live="polite"
                    >
                        <span>
                            <strong id="wc-words">0</strong> words
                        </span>
                        <span>
                            <strong id="wc-minutes">0</strong> min read
                        </span>
                        <span id="wc-warning"></span>
                    </div>
                </div>
            </section>

            <div class="studio-status-row">
                <div class="studio-status" id="save-status" aria-live="polite">
                    {
                        isEditing
                            ? "Ready to save changes to this article."
                            : "Fill in the details, then save a draft or publish."
                    }
                </div>
                <span class="studio-last-saved" id="last-saved" hidden></span>
            </div>

            <div class="studio-form__actions">
                <button
                    class="studio-button"
                    type="submit"
                    name="action"
                    value="save"
                    id="save-draft-btn"
                >
                    Save draft
                </button>
                <button
                    class="studio-button studio-button--accent"
                    type="submit"
                    name="action"
                    value="publish"
                    id="publish-btn"
                >
                    Publish now
                </button>
                {
                    previewUrl && (
                        <a
                            class="studio-button studio-button--secondary"
                            href={previewUrl}
                            target="_blank"
                            rel="noopener"
                        >
                            Preview
                        </a>
                    )
                }
                <span class="studio-form__actions-spacer"></span>
                <button
                    class="studio-button studio-button--danger"
                    type="button"
                    id="delete-article-btn"
                    data-editing={isEditing ? "true" : "false"}
                    style={isEditing ? undefined : "display:none"}
                >
                    Delete article
                </button>
            </div>
        </form>
    </StudioShell>
</BaseLayout>

<script>
    import {
        getStudioConfig,
        hasStudioConfig,
        hasApi,
        getSession,
        getLoginUrl,
        getFile,
        putFile,
        deleteFile,
        slugify,
        fileToBase64,
        serializeArticle,
        type ArticleData,
    } from "../../lib/studio/github";
    import { showToast } from "../../lib/studio/toast";
    import { renderMarkdown } from "../../lib/studio/markdown";

    const form = document.getElementById(
        "studio-editor-form",
    ) as HTMLFormElement | null;
    const status = document.getElementById("save-status") as HTMLElement | null;
    const base = import.meta.env.BASE_URL.replace(/\/$/, "");

    if (!form || !status) {
        throw new Error("Studio editor failed to initialize.");
    }

    let isEditing = form.dataset.editing === "true";
    let originalSlug = form.dataset.originalSlug || "";
    const allSlugs = JSON.parse(form.dataset.slugs || "[]") as string[];

    const slugInput = document.getElementById(
        "field-slug",
    ) as HTMLInputElement | null;
    const titleInput = document.getElementById(
        "field-title",
    ) as HTMLInputElement | null;
    const heroFile = document.getElementById(
        "field-heroimage",
    ) as HTMLInputElement | null;
    const heroPreview = document.getElementById(
        "hero-image-preview",
    ) as HTMLElement | null;
    const heroPreviewImg = document.getElementById(
        "hero-image-preview-img",
    ) as HTMLImageElement | null;
    const heroCaption = document.getElementById(
        "hero-image-caption",
    ) as HTMLElement | null;
    const heroHint = document.getElementById(
        "hero-image-hint",
    ) as HTMLElement | null;
    const removeHeroBtn = document.getElementById(
        "remove-hero-image",
    ) as HTMLButtonElement | null;

    let pendingImage: { base64: string; name: string } | null = null;
    let slugEdited = Boolean(slugInput?.value);

    /* ------------------------------------------------------------------ */
    /* Phase 3 — live preview, word count, autosave, shortcuts, toolbar    */
    /* ------------------------------------------------------------------ */

    const bodyInput = document.getElementById(
        "field-body",
    ) as HTMLTextAreaElement | null;
    const editorGrid = document.getElementById(
        "editor-grid",
    ) as HTMLElement | null;
    const previewEl = document.getElementById(
        "body-preview",
    ) as HTMLElement | null;
    const wcWords = document.getElementById(
        "wc-words",
    ) as HTMLElement | null;
    const wcMinutes = document.getElementById(
        "wc-minutes",
    ) as HTMLElement | null;
    const wcWarning = document.getElementById(
        "wc-warning",
    ) as HTMLElement | null;
    const viewButtons =
        document.querySelectorAll<HTMLButtonElement>("[data-view]");
    const toolbarButtons =
        document.querySelectorAll<HTMLButtonElement>("[data-md]");

    let dirty = false;
    let saving = false;
    let autosaveTimer = 0;
    const AUTOSAVE_KEY = "studio-editor-autosave";
    const saveBtn = document.getElementById(
        "save-draft-btn",
    ) as HTMLButtonElement | null;
    const publishBtn = document.getElementById(
        "publish-btn",
    ) as HTMLButtonElement | null;

    function markDirty() {
        dirty = true;
    }

    /* ---- Live preview + word count ---- */
    function renderPreview() {
        if (!previewEl) return;
        const md = bodyInput?.value ?? "";
        previewEl.innerHTML = md.trim()
            ? renderMarkdown(md)
            : `<p class="studio-preview__empty">Your preview will appear here as you type…</p>`;
    }

    function updateWordCount() {
        if (!bodyInput || !wcWords || !wcMinutes) return;
        const text = bodyInput.value;
        const words = text.trim() ? text.trim().split(/\s+/).length : 0;
        wcWords.textContent = words.toLocaleString();
        wcMinutes.textContent = String(Math.max(1, Math.ceil(words / 200)));
        if (wcWarning) {
            const tooShort = words > 0 && words < 300;
            wcWarning.textContent = tooShort
                ? "Aim for 300+ words — shorter posts rank poorly."
                : "";
            wcWarning.className = tooShort ? "is-warning" : "";
        }
    }

    /* ---- View toggle (Write / Split / Preview) ---- */
    viewButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const view = button.dataset.view || "write";
            viewButtons.forEach((b) =>
                b.classList.toggle("is-active", b === button),
            );
            editorGrid?.classList.toggle("is-split", view === "split");
            editorGrid?.classList.toggle("is-preview", view === "preview");
            if (view === "split" || view === "preview") renderPreview();
        });
    });

    /* ---- Markdown toolbar ---- */
    const MD_SNIPPETS: Record<string, [string, string, string]> = {
        bold: ["**", "**", "bold text"],
        italic: ["*", "*", "italic text"],
        code: ["`", "`", "code"],
        link: ["[", "](https://example.com)", "link text"],
        image: ["![", "](/images/articles/image.png)", "alt text"],
        h2: ["## ", "", "Heading"],
        list: ["- ", "", "List item"],
        quote: ["> ", "", "Quoted text"],
        hr: ["\n---\n", "", ""],
    };

    function insertAtCursor(
        textarea: HTMLTextAreaElement,
        before: string,
        after: string,
        placeholder: string,
    ) {
        const start = textarea.selectionStart ?? textarea.value.length;
        const end = textarea.selectionEnd ?? textarea.value.length;
        const selected =
            textarea.value.slice(start, end) || placeholder;
        textarea.setRangeText(before + selected + after, start, end, "end");
        textarea.focus();
        const newPos = start + before.length + selected.length;
        textarea.setSelectionRange(newPos, newPos);
        textarea.dispatchEvent(
            new Event("input", { bubbles: true }),
        );
    }

    toolbarButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const kind = button.dataset.md;
            if (!kind || !bodyInput) return;
            const [before, after, placeholder] =
                MD_SNIPPETS[kind] ?? ["", "", ""];
            insertAtCursor(bodyInput, before, after, placeholder);
        });
    });

    /* ---- Autosave (sessionStorage) + restore bar ---- */
    interface EditorDraft {
        savedAt: string;
        form: Record<string, string>;
    }

    function collectAutosave(): EditorDraft | null {
        if (!form) return null;
        const data = new FormData(form);
        const out: Record<string, string> = {};
        for (const [key, value] of data.entries()) {
            if (value instanceof File) continue;
            out[key] = value;
        }
        return { savedAt: new Date().toISOString(), form: out };
    }

    function writeAutosave() {
        const draft = collectAutosave();
        if (!draft) return;
        try {
            window.sessionStorage.setItem(
                AUTOSAVE_KEY,
                JSON.stringify(draft),
            );
        } catch {
            // storage full or blocked — autosave is best-effort
        }
    }

    function clearAutosave() {
        try {
            window.sessionStorage.removeItem(AUTOSAVE_KEY);
        } catch {
            // ignore
        }
    }

    function scheduleAutosave() {
        window.clearTimeout(autosaveTimer);
        autosaveTimer = window.setTimeout(writeAutosave, 1200);
    }

    function restoreAutosave() {
        let raw: string | null = null;
        try {
            raw = window.sessionStorage.getItem(AUTOSAVE_KEY);
        } catch {
            return;
        }
        if (!raw) return;
        try {
            const draft = JSON.parse(raw) as EditorDraft;
            for (const [key, value] of Object.entries(draft.form)) {
                const input = form?.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
                    `[name="${key}"]`,
                );
                if (!input) continue;
                if (input instanceof HTMLInputElement && input.type === "file") {
                    continue;
                }
                if (input instanceof HTMLInputElement && input.type === "checkbox") {
                    input.checked = value === "on";
                } else {
                    input.value = value;
                }
            }
            updateWordCount();
            renderPreview();
            markDirty();
            // A restored slug must not be silently overwritten by the title
            // auto-fill listener.
            if (slugInput && slugInput.value.trim()) slugEdited = true;
            setStatus(
                "Unsaved draft restored — review before saving.",
                "info",
            );
        } catch {
            clearAutosave();
        }
    }

    function showRestoreBar(savedAt: string) {
        document.getElementById("autosave-restore")?.remove();
        const bar = document.createElement("div");
        bar.className = "studio-restore";
        bar.id = "autosave-restore";
        const time = new Date(savedAt).toLocaleString(undefined, {
            month: "short",
            day: "numeric",
            hour: "numeric",
            minute: "2-digit",
        });
        bar.innerHTML = `<p><strong>Unsaved draft found</strong> from ${time} — restore it to keep working.</p>`;

        const restoreBtn = document.createElement("button");
        restoreBtn.type = "button";
        restoreBtn.className = "studio-button studio-button--sm";
        restoreBtn.textContent = "Restore draft";
        restoreBtn.addEventListener("click", () => {
            restoreAutosave();
            bar.remove();
            showToast("Draft restored", "success");
        });

        const discardBtn = document.createElement("button");
        discardBtn.type = "button";
        discardBtn.className =
            "studio-button studio-button--secondary studio-button--sm";
        discardBtn.textContent = "Discard";
        discardBtn.addEventListener("click", () => {
            clearAutosave();
            bar.remove();
            showToast("Draft discarded", "info");
        });

        bar.append(restoreBtn, discardBtn);
        form?.prepend(bar);
    }

    // Offer to restore a local draft on new articles only — existing
    // articles load fresh from GitHub, which is always authoritative.
    if (!new URLSearchParams(window.location.search).get("slug")) {
        try {
            const raw = window.sessionStorage.getItem(AUTOSAVE_KEY);
            if (raw) {
                const draft = JSON.parse(raw) as EditorDraft;
                const hasContent = Object.values(draft.form || {}).some(
                    (value) => String(value).trim().length > 0,
                );
                if (hasContent) showRestoreBar(draft.savedAt);
            }
        } catch {
            // ignore — no autosave to restore
        }
    }

    /* ---- Editor defaults from Settings (new articles only) ---- */
    if (!new URLSearchParams(window.location.search).get("slug")) {
        try {
            const raw = window.sessionStorage.getItem(
                "studio-editor-defaults",
            );
            if (raw) {
                const defaults = JSON.parse(raw) as Record<string, string>;
                const fill = (id: string, value: string | undefined) => {
                    if (!value) return;
                    const el = document.getElementById(
                        id,
                    ) as HTMLInputElement | null;
                    if (el && !el.value.trim()) el.value = value;
                };
                fill("field-category", defaults.category);
                fill("field-tags", defaults.tags);
                if (defaults.author) {
                    const authorSelect = document.getElementById(
                        "field-author",
                    ) as HTMLSelectElement | null;
                    if (
                        authorSelect &&
                        [...authorSelect.options].some(
                            (option) => option.value === defaults.author,
                        )
                    ) {
                        authorSelect.value = defaults.author;
                    }
                }
            }
        } catch {
            // ignore — defaults are optional
        }
    }

    /* ---- Dirty-state warnings ---- */
    form?.addEventListener("input", () => {
        dirty = true;
        scheduleAutosave();
        updateWordCount();
        renderPreview();
    });

    form?.addEventListener("change", () => {
        dirty = true;
        scheduleAutosave();
    });

    window.addEventListener("beforeunload", (event) => {
        if (!dirty) return;
        event.preventDefault();
        event.returnValue = "";
    });

    // Confirm before leaving to another Studio page with unsaved changes.
    document.addEventListener("click", (event) => {
        if (!dirty) return;
        const anchor = (event.target as HTMLElement).closest<HTMLAnchorElement>(
            "a[href]",
        );
        if (!anchor) return;
        if (form?.contains(anchor)) return; // in-form links (Preview) are fine
        const href = anchor.getAttribute("href") || "";
        if (!href || href.startsWith("#")) return;
        if (
            !window.confirm(
                "You have unsaved changes. Leave anyway?",
            )
        ) {
            event.preventDefault();
            event.stopPropagation();
        }
    });

    /* ------------------------------------------------------------------ */
    /* Client-side article loading for edit / duplicate mode                */
    /* ------------------------------------------------------------------ */
    /**
     * Simple YAML frontmatter parser for the article format produced by
     * serializeArticle(). Handles quoted scalars, block scalars (>-),
     * boolean values, arrays and plain strings.
     */
    function parseFrontmatter(raw: string): {
        frontmatter: Record<string, unknown>;
        body: string;
    } {
        const match = raw.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n([\s\S]*)$/);
        if (!match) return { frontmatter: {}, body: raw };

        const fm: Record<string, unknown> = {};
        const lines = match[1].split(/\r?\n/);
        let currentKey = "";
        let blockScalar = "";
        let inArray = false;
        const arrayValues: string[] = [];

        for (const line of lines) {
            // Block scalar (>- folded, or | literal)
            if (blockScalar) {
                const indent = line.match(/^(\s*)/)?.[1] ?? "";
                if (indent.length >= 2 || line.trim() === "") {
                    const prev = String(fm[currentKey] ?? "");
                    const trimmed = line.trimStart();
                    if (blockScalar === "|") {
                        // literal — keep newlines
                        fm[currentKey] = prev + (prev ? "\n" : "") + trimmed;
                    } else {
                        // folded — a single newline becomes a space, a blank
                        // line becomes a real newline
                        if (line.trim() === "") {
                            fm[currentKey] = prev + "\n";
                        } else if (prev === "" || prev.endsWith("\n")) {
                            fm[currentKey] = prev + trimmed;
                        } else {
                            fm[currentKey] = prev + " " + trimmed;
                        }
                    }
                    continue;
                } else {
                    blockScalar = "";
                }
            }

            // Array item
            const arrayMatch = line.match(/^\s+-\s+(.+)/);
            if (arrayMatch && currentKey) {
                inArray = true;
                arrayValues.push(unquote(arrayMatch[1]));
                continue;
            }

            // Flush pending array
            if (inArray && currentKey) {
                fm[currentKey] = [...arrayValues];
                arrayValues.length = 0;
                inArray = false;
            }

            // Key: value
            const kvMatch = line.match(/^([a-zA-Z][a-zA-Z0-9]*):\s*(.*)/);
            if (kvMatch) {
                currentKey = kvMatch[1];
                const val = kvMatch[2].trim();

                if (val === ">-") {
                    blockScalar = ">-";
                    fm[currentKey] = "";
                } else if (val === "true") {
                    fm[currentKey] = true;
                } else if (val === "false") {
                    fm[currentKey] = false;
                } else if (val === "[]" || val === "") {
                    fm[currentKey] = [];
                } else {
                    fm[currentKey] = unquote(val);
                }
            }
        }

        // Flush trailing array
        if (inArray && currentKey) {
            fm[currentKey] = [...arrayValues];
        }

        return { frontmatter: fm, body: match[2].replace(/^\n/, "") };
    }

    function unquote(s: string): string {
        return s.replace(/^"(.*)"$/, "$1").replace(/^'(.*)'$/, "$1");
    }

    /**
     * Normalize a YAML/ISO pubDate value into a format <input
     * type="datetime-local"> accepts (YYYY-MM-DDTHH:mm in local time).
     * Date-only values (existing articles) map to midnight local time so the
     * exact calendar date is preserved in the visitor's timezone (and the
     * value is still accepted by the datetime-local input).
     */
    function normalizeDateTime(value: unknown): string {
        const str = String(value ?? "").trim();
        if (!str) return "";
        // Date-only (existing articles): treat as midnight local time.
        if (/^\d{4}-\d{2}-\d{2}$/.test(str)) return `${str}T00:00`;
        const date = new Date(str);
        if (Number.isNaN(date.getTime())) return str;
        const pad = (n: number) => String(n).padStart(2, "0");
        return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
    }

    /**
     * When the URL contains ?slug=... (or ?slug=...&duplicate=1), load
     * the article from GitHub so the form is pre-populated with real data.
     */
    async function loadArticleFromUrl() {
        const params = new URLSearchParams(window.location.search);
        const urlSlug = params.get("slug") || "";
        const urlDuplicate = params.get("duplicate") === "1";

        if (!urlSlug) return; // no slug → new article, nothing to load

        const apiMode = hasApi();
        const config = getStudioConfig();

        if (!apiMode && !config) {
            setStatus(
                "GitHub is not connected — open Studio → Settings first.",
                "error",
            );
            return;
        }

        setStatus("Loading article from GitHub…");

        try {
            const mdPath = `src/content/articles/${urlSlug}.md`;
            const file = await getFile(mdPath, {
                config: apiMode ? undefined : (config ?? undefined),
                decode: true,
            });
            if (!file?.content) {
                setStatus(`Article "${urlSlug}" not found on GitHub.`, "error");
                return;
            }

            const { frontmatter: fm, body } = parseFrontmatter(file.content);

            // Update the editing state so saveArticle uses the right slug
            const editingFlag = urlDuplicate ? "false" : "true";
            const origSlug = urlDuplicate ? `${urlSlug}-copy` : urlSlug;
            if (form) {
                form.dataset.editing = editingFlag;
                form.dataset.originalSlug = origSlug;
            }
            // Re-read local copies so saveArticle() uses the right slug
            isEditing = editingFlag === "true";
            originalSlug = origSlug;

            // Update the page header
            const headerH2 = document.querySelector(".studio-header h2");
            if (headerH2) {
                headerH2.textContent = urlDuplicate
                    ? "Duplicate article"
                    : "Edit article";
            }

            const editorForm = form;
            if (!editorForm) return;

            // Populate text fields
            const setValue = (id: string, val: unknown) => {
                const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
                if (el && val != null) el.value = String(val);
            };

            setValue("field-title", fm.title);
            setValue("field-description", fm.description);
            setValue("field-pubdate", normalizeDateTime(fm.pubDate));
            setValue("field-updated", fm.updatedDate);
            setValue("field-category", fm.category);
            setValue("field-tags", Array.isArray(fm.tags) ? fm.tags.join(", ") : fm.tags);
            setValue("field-heroimage", null); // file input, skip
            setValue("field-alt", fm.featuredImageAlt);
            setValue("field-seotitle", fm.seoTitle);
            setValue("field-seodesc", fm.seoDescription);
            setValue("field-canonical", fm.canonicalURL);
            setValue("field-body", body.replace(/\n$/, ""));

            // Author (select)
            if (fm.author) {
                const authorSelect = document.getElementById("field-author") as HTMLSelectElement | null;
                if (authorSelect) {
                    // Ensure the option exists
                    const val = String(fm.author);
                    if (![...authorSelect.options].some((o) => o.value === val)) {
                        const opt = document.createElement("option");
                        opt.value = val;
                        opt.textContent = val;
                        authorSelect.appendChild(opt);
                    }
                    authorSelect.value = val;
                }
            }

            // Checkboxes
            const featuredCb = editorForm.querySelector<HTMLInputElement>('input[name="featured"]');
            if (featuredCb) featuredCb.checked = Boolean(fm.featured);
            const draftCb = editorForm.querySelector<HTMLInputElement>('input[name="draft"]');
            if (draftCb) draftCb.checked = urlDuplicate ? true : Boolean(fm.draft);
            const archivedCb = editorForm.querySelector<HTMLInputElement>('input[name="archived"]');
            if (archivedCb) archivedCb.checked = urlDuplicate ? false : Boolean(fm.archived);

            // Hidden hero image path
            const heroHidden = editorForm.querySelector<HTMLInputElement>('input[name="heroImage"]');
            if (heroHidden) {
                heroHidden.value = urlDuplicate ? "" : String(fm.heroImage || "");
            }

            // Show hero image preview if present
            if (!urlDuplicate && fm.heroImage) {
                showPreview(`${base}${fm.heroImage}`, "Current hero image");
            }

            // Slug field handling: show for duplicate, hide for edit
            if (urlDuplicate) {
                const slugField = document.getElementById("field-slug") as HTMLInputElement | null;
                if (slugField) {
                    slugField.value = `${urlSlug}-copy`;
                    // The slug is set programmatically — mark it as edited so
                    // typing in the title does NOT overwrite the -copy slug.
                    slugEdited = true;
                }
            } else {
                // Hide the slug field container when editing an existing article
                const slugFieldContainer = document.getElementById("field-slug")?.closest(".studio-field");
                if (slugFieldContainer) slugFieldContainer.setAttribute("hidden", "");
            }

            // Add preview link for published non-draft articles
            if (!urlDuplicate && fm.draft === false) {
                const actionsDiv = document.querySelector(".studio-form__actions");
                if (actionsDiv && !actionsDiv.querySelector("a[href*='/articles/']")) {
                    const previewLink = document.createElement("a");
                    previewLink.className = "studio-button studio-button--secondary";
                    previewLink.href = `${base}/articles/${urlSlug}/`;
                    previewLink.target = "_blank";
                    previewLink.rel = "noopener";
                    previewLink.textContent = "Preview";
                    actionsDiv.appendChild(previewLink);
                }
            }

            setStatus(
                urlDuplicate
                    ? `Duplicating "${urlSlug}" — edit the slug and details, then save.`
                    : `Loaded "${urlSlug}" — make your changes and save.`,
                "info",
            );
            dirty = false;
            updateWordCount();
            renderPreview();
            observeDeleteBtn();
        } catch (err) {
            const statusCode = (err as { status?: number })?.status;
            if (apiMode && statusCode === 401) {
                // Session expired or missing — send the editor to login
                window.location.assign(getLoginUrl(window.location.href));
                return;
            }
            setStatus(
                `Failed to load article: ${err instanceof Error ? err.message : String(err)}`,
                "error",
            );
        }
    }

    // Kick off client-side loading immediately
    void loadArticleFromUrl();

    /* ---- Slug auto-fill from title (new articles only) ---- */
    titleInput?.addEventListener("input", () => {
        if (isEditing || !slugInput || slugEdited) return;
        slugInput.value = slugify(titleInput.value);
    });

    slugInput?.addEventListener("input", () => {
        slugEdited = true;
    });

    /* ---- Show the existing hero image (edit + duplicate mode) ---- */
    const existingHero = document.querySelector<HTMLInputElement>(
        'input[name="heroImage"]',
    )?.value;
    if (existingHero && !new URLSearchParams(window.location.search).get("slug")) {
        showPreview(`${base}${existingHero}`, "Current hero image");
    }

    function handleHeroFile(file: File | undefined) {
        if (!file) return;
        if (!file.type.startsWith("image/")) {
            setStatus(
                "Please choose an image file (PNG, JPG, WebP or GIF).",
                "error",
            );
            if (heroFile) heroFile.value = "";
            return;
        }
        const objectUrl = URL.createObjectURL(file);
        showPreview(
            objectUrl,
            `${file.name} — will be uploaded on save`,
        );
        void fileToBase64(file).then((base64) => {
            pendingImage = { base64, name: file.name };
        });
        removeHeroBtn?.removeAttribute("hidden");
        // File inputs don't fire "input" events — mark the form dirty here so
        // the beforeunload warning and autosave catch hero image changes too.
        markDirty();
        scheduleAutosave();
    }

    heroFile?.addEventListener("change", () => {
        const file = heroFile.files?.[0];
        handleHeroFile(file);
        if (heroFile) heroFile.value = "";
    });

    // Drag & drop onto the hero image control.
    const heroDropZone = document.querySelector<HTMLElement>(
        ".studio-file-input",
    );
    heroDropZone?.addEventListener("dragover", (event) => {
        event.preventDefault();
        heroDropZone.classList.add("is-dragging");
    });
    heroDropZone?.addEventListener("dragleave", () => {
        heroDropZone.classList.remove("is-dragging");
    });
    heroDropZone?.addEventListener("drop", (event) => {
        event.preventDefault();
        heroDropZone.classList.remove("is-dragging");
        const file = event.dataTransfer?.files?.[0];
        handleHeroFile(file);
    });

    removeHeroBtn?.addEventListener("click", () => {
        pendingImage = null;
        if (heroFile) heroFile.value = "";
        const hidden = document.querySelector<HTMLInputElement>(
            'input[name="heroImage"]',
        );
        if (hidden) hidden.value = "";
        heroPreview?.setAttribute("hidden", "");
        removeHeroBtn?.setAttribute("hidden", "");
        if (heroHint) heroHint.textContent = "No hero image will be saved.";
        markDirty();
        scheduleAutosave();
    });

    function showPreview(src: string, caption: string) {
        if (heroPreviewImg) heroPreviewImg.src = src;
        if (heroCaption) heroCaption.textContent = caption;
        heroPreview?.removeAttribute("hidden");
        removeHeroBtn?.removeAttribute("hidden");
    }

    // NOTE: declared as a hoisted function (not a const arrow) on purpose —
    // loadArticleFromUrl() runs at module top level and calls setStatus()
    // before its first await, which would hit the temporal dead zone and
    // crash article loading if this were a const declared later in the file.
    function setStatus(
        message: string,
        kind: "info" | "success" | "error" = "info",
    ) {
        if (!status) return;
        status.className = "studio-status";
        if (kind === "success") status.classList.add("studio-status--success");
        if (kind === "error") status.classList.add("studio-status--error");
        status.textContent = message;
    }

    /* ---- Save / publish ---- */
    /* ---- Delete article ---- */
    const deleteBtn = document.getElementById("delete-article-btn") as HTMLButtonElement | null;
    if (deleteBtn && isEditing && originalSlug) {
        deleteBtn.removeAttribute("style");
        deleteBtn.addEventListener("click", async () => {
            const slugToDelete = originalSlug;
            const confirmed = window.confirm(
                `Delete "${slugToDelete}"? This permanently removes the article from GitHub and cannot be undone.`,
            );
            if (!confirmed) return;

            const apiMode = hasApi();
            const config = getStudioConfig();
            if (!apiMode && !config) {
                setStatus("GitHub is not connected. Open Studio → Settings first.", "error");
                return;
            }

            deleteBtn.disabled = true;
            deleteBtn.textContent = "Deleting…";
            setStatus("Deleting article from GitHub…");

            try {
                const mdPath = `src/content/articles/${slugToDelete}.md`;
                const removed = await deleteFile(
                    mdPath,
                    `Studio: delete article ${slugToDelete}`,
                );
                if (!removed) {
                    setStatus(`Article "${slugToDelete}" was not found on GitHub.`, "error");
                    deleteBtn.disabled = false;
                    deleteBtn.textContent = "Delete article";
                    return;
                }
                showToast(`"${slugToDelete}" deleted. The site rebuilds in a few minutes.`, "success");
                setStatus(`✓ Deleted "${slugToDelete}". Redirecting…`, "success");
                dirty = false;
                window.setTimeout(() => {
                    window.location.assign(`${base}/studio/articles`);
                }, 1200);
            } catch (err) {
                deleteBtn.disabled = false;
                deleteBtn.textContent = "Delete article";
                const statusCode = (err as { status?: number })?.status;
                if (apiMode && statusCode === 401) {
                    setStatus("Your GitHub session expired. Redirecting to sign in…", "error");
                    window.setTimeout(() => {
                        window.location.assign(getLoginUrl(window.location.href));
                    }, 1200);
                    return;
                }
                setStatus(
                    `Delete failed: ${err instanceof Error ? err.message : String(err)}`,
                    "error",
                );
            }
        });
    }

    /* ---- Show delete button when editing (client-side load sets isEditing) ---- */
    const observeDeleteBtn = () => {
        if (deleteBtn && isEditing && originalSlug) {
            deleteBtn.removeAttribute("style");
        }
    };

    const saveArticle = async (action: "save" | "publish") => {
        const apiMode = hasApi();
        const config = getStudioConfig();
        if (!apiMode && !config) {
            setStatus(
                "GitHub is not connected. Open Studio → Settings and save your GitHub token first.",
                "error",
            );
            return;
        }

        const formData = new FormData(form);
        const title = String(formData.get("title") || "").trim();
        const description = String(formData.get("description") || "").trim();
        const category = String(formData.get("category") || "").trim();
        const pubDate = String(formData.get("pubDate") || "");
        const author = String(formData.get("author") || "").trim();
        const tags = String(formData.get("tags") || "")
            .split(",")
            .map((tag) => tag.trim())
            .filter(Boolean);
        const featured = formData.get("featured") === "on";
        // "Publish now" always clears draft. New articles always save as
        // drafts; existing articles keep the draft checkbox the user set.
        const draft = action === "publish"
            ? false
            : isEditing
              ? formData.get("draft") === "on"
              : true;
        const draftCheckbox = form.querySelector<HTMLInputElement>(
            'input[name="draft"]',
        );
        if (draftCheckbox) draftCheckbox.checked = draft;
        // "Publish now" always un-archives; otherwise keep the user's choice.
        const archived =
            action === "publish"
                ? false
                : formData.get("archived") === "on";
        const archivedCheckbox = form.querySelector<HTMLInputElement>(
            'input[name="archived"]',
        );
        if (archivedCheckbox) archivedCheckbox.checked = archived;
        const updatedDate = String(formData.get("updatedDate") || "");
        const heroImage = String(formData.get("heroImage") || "");
        const featuredImageAlt = String(formData.get("featuredImageAlt") || "").trim();
        const seoTitle = String(formData.get("seoTitle") || "").trim();
        const seoDescription = String(formData.get("seoDescription") || "").trim();
        const canonicalURL = String(formData.get("canonicalURL") || "").trim();
        const body = String(formData.get("body") || "");

        let slug = originalSlug;
        if (!isEditing) {
            slug = String(formData.get("slug") || "")
                .trim()
                .toLowerCase();
            if (!/^[a-z0-9-]+$/.test(slug)) {
                setStatus(
                    "Slug must contain only lowercase letters, numbers and dashes.",
                    "error",
                );
                return;
            }
            if (allSlugs.includes(slug)) {
                setStatus(
                    `An article with the slug "${slug}" already exists. Choose a different slug.`,
                    "error",
                );
                return;
            }
        }

        const required = [
            ["Title", title],
            ["Description", description],
            ["Category", category],
            ["Published date", pubDate],
        ] as const;
        for (const [label, value] of required) {
            if (!value) {
                setStatus(`${label} is required.`, "error");
                return;
            }
        }

        const articleData: ArticleData = {
            title,
            description,
            pubDate,
            updatedDate: updatedDate || undefined,
            author,
            category,
            tags,
            featured,
            draft,
            archived: archived || undefined,
            heroImage: heroImage || undefined,
            featuredImageAlt: featuredImageAlt || undefined,
            seoTitle: seoTitle || undefined,
            seoDescription: seoDescription || undefined,
            canonicalURL: canonicalURL || undefined,
        };

        const mdPath = `src/content/articles/${slug}.md`;

        // Guard against double submits (Ctrl+S spam / double-click): two
        // concurrent PUTs reading the same sha would conflict on GitHub.
        if (saving) return;
        saving = true;
        if (saveBtn) saveBtn.disabled = true;
        if (publishBtn) publishBtn.disabled = true;

        setStatus(
            action === "publish"
                ? "Publishing — committing to GitHub…"
                : "Saving draft — committing to GitHub…",
        );

        try {
            /* 1. Upload a newly selected hero image */
            if (pendingImage) {
                setStatus("Uploading hero image…");
                const extMatch = pendingImage.name.match(/\.([a-z0-9]+)$/i);
                const ext = extMatch ? extMatch[1].toLowerCase() : "png";
                const imagePath = `public/images/articles/${slug}.${ext}`;
                const existingImage = await getFile(imagePath, {
                    config: apiMode ? undefined : (config ?? undefined),
                    decode: false,
                });
                await putFile(
                    imagePath,
                    pendingImage.base64,
                    `Studio: upload hero image for ${slug}`,
                    {
                        sha: existingImage?.sha,
                        base64: true,
                        config: apiMode ? undefined : (config ?? undefined),
                    },
                );
                articleData.heroImage = `/images/articles/${slug}.${ext}`;
                pendingImage = null;
            }

            /* 2. Commit the article markdown */
            const markdown = serializeArticle(articleData, body);
            const existing = await getFile(mdPath, {
                config: apiMode ? undefined : (config ?? undefined),
                decode: false,
            });
            await putFile(
                mdPath,
                markdown,
                `Studio: ${action === "publish" ? "publish" : "save draft"} ${slug}`,
                {
                    sha: existing?.sha,
                    config: apiMode ? undefined : (config ?? undefined),
                },
            );

            const verb = action === "publish" ? "published" : "saved as a draft";
            setStatus(
                `✓ ${verb}. Pushed to GitHub — the live site rebuilds automatically in a few minutes.`,
                "success",
            );
            showToast(
                action === "publish"
                    ? "Article published — the site rebuilds in a few minutes"
                    : "Draft saved to GitHub",
                "success",
            );
            clearAutosave();
            dirty = false;
            saving = false;
            if (saveBtn) saveBtn.disabled = false;
            if (publishBtn) publishBtn.disabled = false;
            // Show a "last saved" timestamp
            const now = new Date();
            const savedLabel = document.getElementById("last-saved");
            if (savedLabel) {
                savedLabel.textContent = `Last saved ${now.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" })}`;
                savedLabel.removeAttribute("hidden");
            }
        } catch (err) {
            saving = false;
            if (saveBtn) saveBtn.disabled = false;
            if (publishBtn) publishBtn.disabled = false;
            const statusCode = (err as { status?: number })?.status;
            if (apiMode && statusCode === 401) {
                setStatus(
                    "Your GitHub session expired. Redirecting to sign in…",
                    "error",
                );
                window.setTimeout(() => {
                    window.location.assign(getLoginUrl(window.location.href));
                }, 1200);
                return;
            }
            setStatus(
                `Save failed: ${err instanceof Error ? err.message : String(err)}`,
                "error",
            );
        }
    }

    /* Show a hint when GitHub isn't configured yet */
    if (!hasApi() && !hasStudioConfig()) {
        setStatus(
            "GitHub is not connected yet — open Studio → Settings and save your token before saving.",
            "info",
        );
    } else if (hasApi()) {
        void getSession().then((session) => {
            if (!session?.authenticated) {
                setStatus(
                    "You are not signed in — the editor will redirect you to sign in before loading or saving.",
                    "info",
                );
            }
        });
    }

    form.addEventListener("submit", (event) => {
        event.preventDefault();
        const submitter = event.submitter as HTMLButtonElement | null;
        const action = submitter?.value === "publish" ? "publish" : "save";

        if (action === "publish") {
            const titleVal = (titleInput?.value || "").trim() || "Untitled";
            const confirmed = window.confirm(
                `Publish "${titleVal}"?\n\nThis will commit the article to GitHub and it will be live on the site once the build completes.`,
            );
            if (!confirmed) return;
        }

        void saveArticle(action);
    });

    /* ---- Live SEO analysis panel ---- */
    const seoTitleCount = document.getElementById("seo-title-count");
    const seoDescCount = document.getElementById("seo-desc-count");
    const seoBodyWords = document.getElementById("seo-body-words");
    const seoOgTitle = document.getElementById("seo-og-title");
    const seoOgDesc = document.getElementById("seo-og-desc");
    const seoOgImage = document.getElementById("seo-og-image");
    const seoOgImageHint = document.getElementById("seo-og-image-hint");
    const seoSlugHint = document.getElementById("seo-slug-hint");
    const seoCategoryHint = document.getElementById("seo-category-hint");
    const seoAltHint = document.getElementById("seo-alt-text-hint");

    function setSeoCheck(key: string, status: "pass" | "warn" | "fail" | "") {
        const el = document.querySelector<HTMLElement>(`[data-seo="${key}"]`);
        if (!el) return;
        el.classList.remove("seo-check--pass", "seo-check--warn", "seo-check--fail");
        if (status) el.classList.add(`seo-check--${status}`);
    }

    function runSeoAnalysis() {
        const title = (titleInput?.value || "").trim();
        const seoTitle = (
            document.getElementById("field-seotitle") as HTMLInputElement | null
        )?.value?.trim();
        const effectiveTitle = seoTitle || title;
        const description = (
            document.getElementById("field-description") as HTMLTextAreaElement | null
        )?.value?.trim();
        const seoDesc = (
            document.getElementById("field-seodesc") as HTMLTextAreaElement | null
        )?.value?.trim();
        const effectiveDesc = seoDesc || description;
        const body = bodyInput?.value || "";
        const bodyWords = body.trim() ? body.trim().split(/\s+/).length : 0;
        const altText = (
            document.getElementById("field-alt") as HTMLInputElement | null
        )?.value?.trim();
        const heroImage = pendingImage
            ? "pending"
            : (
                document.querySelector<HTMLInputElement>("input[name=heroImage]")
            )?.value?.trim();
        const slug = isEditing
            ? originalSlug
            : (slugInput?.value || "").trim();
        const category = (
            document.getElementById("field-category") as HTMLInputElement | null
        )?.value?.trim();

        // 1. Title length
        const titleLen = effectiveTitle.length;
        if (seoTitleCount) seoTitleCount.textContent = String(titleLen);
        if (titleLen === 0) setSeoCheck("title-length", "fail");
        else if (titleLen > 60) setSeoCheck("title-length", "warn");
        else if (titleLen >= 50) setSeoCheck("title-length", "pass");
        else setSeoCheck("title-length", "warn");

        // 2. Description length
        const descLen = effectiveDesc.length;
        if (seoDescCount) seoDescCount.textContent = String(descLen);
        if (descLen === 0) setSeoCheck("desc-length", "fail");
        else if (descLen > 160) setSeoCheck("desc-length", "warn");
        else if (descLen >= 150) setSeoCheck("desc-length", "pass");
        else setSeoCheck("desc-length", "warn");

        // 3. Alt text
        if (heroImage === "pending") {
            if (altText) {
                setSeoCheck("alt-text", "pass");
                if (seoAltHint) seoAltHint.textContent = "Alt text is set — good for accessibility and SEO.";
            } else {
                setSeoCheck("alt-text", "warn");
                if (seoAltHint) seoAltHint.textContent = "New hero image selected — add alt text before saving.";
            }
        } else if (heroImage) {
            if (altText) {
                setSeoCheck("alt-text", "pass");
                if (seoAltHint) seoAltHint.textContent = "Alt text is set — good for accessibility and SEO.";
            } else {
                setSeoCheck("alt-text", "warn");
                if (seoAltHint) seoAltHint.textContent = "Hero image is set but alt text is missing — add a description.";
            }
        } else {
            setSeoCheck("alt-text", "pass");
            if (seoAltHint) seoAltHint.textContent = "No hero image — alt text check skipped.";
        }

        // 4. Body word count
        if (seoBodyWords) seoBodyWords.textContent = String(bodyWords);
        if (bodyWords === 0) setSeoCheck("body-length", "fail");
        else if (bodyWords < 300) setSeoCheck("body-length", "warn");
        else setSeoCheck("body-length", "pass");

        // 5. Slug
        if (slug) {
            setSeoCheck("slug", "pass");
            if (seoSlugHint) seoSlugHint.textContent = `URL: /articles/${slug}/`;
        } else {
            setSeoCheck("slug", "warn");
            if (seoSlugHint) seoSlugHint.textContent = "Set a slug — it defines the article URL.";
        }

        // 6. Category
        if (category) {
            setSeoCheck("category", "pass");
            if (seoCategoryHint) seoCategoryHint.textContent = `Category: ${category}`;
        } else {
            setSeoCheck("category", "warn");
            if (seoCategoryHint) seoCategoryHint.textContent = "Assign a category so articles are grouped correctly.";
        }

        // Open Graph preview
        if (seoOgTitle) seoOgTitle.textContent = effectiveTitle || "Article title";
        if (seoOgDesc) seoOgDesc.textContent = effectiveDesc || "Article description will appear here.";
        if (heroImage === "pending") {
            // Newly uploaded image — use the file input preview
            const previewImg = document.getElementById("hero-image-preview-img") as HTMLImageElement | null;
            if (seoOgImage && previewImg?.src) {
                seoOgImage.innerHTML = `<img src="${previewImg.src}" alt="" />`;
            } else if (seoOgImage) {
                seoOgImage.innerHTML = `<span>New hero image selected</span>`;
            }
        } else if (heroImage) {
            if (seoOgImage) {
                seoOgImage.innerHTML = `<img src="${base}${heroImage}" alt="" />`;
            }
        } else {
            if (seoOgImage) seoOgImage.innerHTML = `<span>No hero image set</span>`;
        }
    }

    // Initial run + live updates on input
    runSeoAnalysis();
    form?.addEventListener("input", () => {
        runSeoAnalysis();
    });

    /* ---- Keyboard shortcuts ---- */
    document.addEventListener("keydown", (event) => {
        const mod = event.ctrlKey || event.metaKey;
        if (!mod) return;
        const key = event.key.toLowerCase();

        // Ctrl/Cmd+S → save draft · Ctrl/Cmd+Shift+S → publish now
        if (key === "s") {
            event.preventDefault();
            void saveArticle(event.shiftKey ? "publish" : "save");
            return;
        }

        // Markdown formatting while the cursor is in the body editor
        if (!bodyInput || document.activeElement !== bodyInput) return;
        if (key === "b") {
            event.preventDefault();
            insertAtCursor(bodyInput, "**", "**", "bold text");
        } else if (key === "i") {
            event.preventDefault();
            insertAtCursor(bodyInput, "*", "*", "italic text");
        } else if (key === "k") {
            event.preventDefault();
            insertAtCursor(
                bodyInput,
                "[",
                "](https://example.com)",
                "link text",
            );
        } else if (key === "e") {
            event.preventDefault();
            insertAtCursor(bodyInput, "`", "`", "code");
        }
    });
</script>
