---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StudioShell from "../../components/studio/StudioShell.astro";
import { getArticleStatus } from "../../lib/articles";

const posts = await getCollection("articles");
const publishedCount = posts.filter(
    (post) => getArticleStatus(post) === "published",
).length;
const draftCount = posts.filter(
    (post) => getArticleStatus(post) === "draft",
).length;
const scheduledCount = posts.filter(
    (post) => getArticleStatus(post) === "scheduled",
).length;
const recentPosts = posts
    .slice()
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, 5)
    .map((post) => ({
        title: post.data.title,
        status: getArticleStatus(post),
        pubDate: post.data.pubDate.toISOString(),
        updated:
            post.data.updatedDate?.toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
                year: "numeric",
            }) ||
            post.data.pubDate.toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
                year: "numeric",
            }),
        slug: post.id,
    }));

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
    title="Studio | The Technology Joint"
    description="Private publishing workspace for The Technology Joint."
    noindex
>
    <StudioShell active="dashboard">
        <header class="studio-header">
            <div>
                <p class="studio-eyebrow">Studio overview</p>
                <h2>Publishing workspace</h2>
                <p class="studio-lead">
                    Review status, ship updates, and keep your editorial
                    calendar moving with a calmer workspace.
                </p>
            </div>
            <a class="studio-button" href={`${base}/studio/editor`}
                >New article</a
            >
        </header>

        <section class="studio-hero">
            <article class="studio-hero__card">
                <p class="studio-card__eyebrow">Ready to publish</p>
                <h3>Keep the next article moving with one click.</h3>
                <p>
                    Write from any device, then save a draft or publish — the
                    studio commits straight to GitHub and the site rebuilds
                    automatically.
                </p>
            </article>
            <div class="studio-hero__actions">
                <a
                    class="studio-button"
                    href={`${base}/studio/editor`}
                    >Write new article</a
                >
                <a
                    class="studio-button studio-button--secondary"
                    href={`${base}/studio/articles`}
                    >Manage articles</a
                >
            </div>
        </section>

        <section class="studio-metrics" aria-label="Studio metrics">
            <article class="studio-metric">
                <p class="studio-metric__label">Published</p>
                <strong>{publishedCount}</strong>
            </article>
            <article class="studio-metric">
                <p class="studio-metric__label">Scheduled</p>
                <strong>{scheduledCount}</strong>
            </article>
            <article class="studio-metric">
                <p class="studio-metric__label">Drafts</p>
                <strong>{draftCount}</strong>
            </article>
            <article class="studio-metric">
                <p class="studio-metric__label">Total articles</p>
                <strong>{posts.length}</strong>
            </article>
        </section>

        <section class="studio-grid">
            <article class="studio-panel">
                <div class="studio-panel__header">
                    <h3>Recent activity</h3>
                    <a class="studio-link" href={`${base}/studio/articles`}
                        >View all</a
                    >
                </div>
                {
                    recentPosts.length > 0 ? (
                        <ul class="studio-list">
                            {
                                recentPosts.map((post) => (
                                    <li>
                                        <div>
                                            <strong>{post.title}</strong>
                                            <p>
                                                <span
                                                    class:list={[
                                                        "studio-badge",
                                                        post.status === "draft"
                                                            ? "studio-badge--draft"
                                                            : post.status ===
                                                                "scheduled"
                                                              ? "studio-badge--scheduled"
                                                              : "studio-badge--published",
                                                    ]}
                                                    data-status={post.status}
                                                    data-pubdate={post.pubDate}
                                                >
                                                    {post.status === "draft"
                                                        ? "Draft"
                                                        : post.status ===
                                                            "scheduled"
                                                          ? "Scheduled"
                                                          : "Published"}
                                                </span>
                                                <span class="studio-list__date">
                                                    {post.updated}
                                                </span>
                                            </p>
                                        </div>
                                        <a
                                            class="studio-link"
                                            href={`${base}/studio/editor?slug=${post.slug}`}
                                        >
                                            Edit
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    ) : (
                        <p class="studio-lead">
                            No articles yet. Write your first one to get
                            started.
                        </p>
                    )
                }
            </article>

            <article class="studio-panel">
                <div class="studio-panel__header">
                    <h3>Quick actions</h3>
                </div>
                <div class="studio-actions">
                    <a
                        class="studio-button studio-button--secondary"
                        href={`${base}/studio/editor`}
                    >
                        New article
                    </a>
                    <a
                        class="studio-button studio-button--secondary"
                        href={`${base}/studio/articles`}
                    >
                        Manage articles
                    </a>
                    <a
                        class="studio-button studio-button--secondary"
                        href={`${base}/studio/media`}
                    >
                        Media library
                    </a>
                    <a
                        class="studio-button studio-button--secondary"
                        href={`${base}/studio/settings`}
                    >
                        GitHub settings
                    </a>
                </div>
            </article>
        </section>
    </StudioShell>
</BaseLayout>

<style>
    .studio-list__date {
        color: var(--color-muted);
        margin-left: 0.6rem;
        font-size: 0.85rem;
    }
</style>

<script>
    // Keep Draft / Scheduled / Published badges accurate against the current
    // time: a scheduled article flips to "Published" the moment its pubDate
    // passes, without waiting for a rebuild.
    const BADGE_LABELS: Record<string, string> = {
        draft: "Draft",
        scheduled: "Scheduled",
        published: "Published",
    };
    const BADGE_CLASSES: Record<string, string> = {
        draft: "studio-badge--draft",
        scheduled: "studio-badge--scheduled",
        published: "studio-badge--published",
    };
    const now = Date.now();
    document
        .querySelectorAll("[data-status][data-pubdate]")
        .forEach((el) => {
            const pubDate = Number(
                new Date(el.getAttribute("data-pubdate") || ""),
            );
            const isDraft = el.getAttribute("data-status") === "draft";
            const status = isDraft
                ? "draft"
                : pubDate > now
                  ? "scheduled"
                  : "published";
            el.classList.remove(
                "studio-badge--draft",
                "studio-badge--scheduled",
                "studio-badge--published",
            );
            el.classList.add(BADGE_CLASSES[status]);
            el.textContent = BADGE_LABELS[status];
            el.setAttribute("data-status", status);
        });
</script>
