---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StudioShell from "../../components/studio/StudioShell.astro";
import { hasApi, getAuthMode } from "../../lib/studio/github";

// Build-safe: hasApi() returns false when PUBLIC_STUDIO_API_URL is unset,
// so the missing variable can never break the build or this page.
const hasRemote = hasApi();
const authMode = getAuthMode();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
    title="Studio Settings | The Technology Joint"
    description="Configure Studio defaults and publishing preferences."
    noindex
>
    <StudioShell active="settings">
        <header class="studio-header">
            <div>
                <p class="studio-eyebrow">Workspace defaults</p>
                <h2>Studio settings</h2>
                <p class="studio-lead">
                    Connect the studio to GitHub so saves and publishes reach
                    the live site.
                </p>
            </div>
        </header>

        <section class="studio-grid studio-grid--settings">
            <article class="studio-panel">
                <div class="studio-panel__header">
                    <h3>GitHub connection</h3>
                </div>

                {
                    hasRemote && (
                        <div
                            class="studio-panel studio-oauth-status"
                            id="oauth-status"
                        >
                            <div class="studio-panel__header">
                                <h3>Account</h3>
                            </div>
                            <p class="studio-lead" id="oauth-status-text">
                                Checking your session…
                            </p>
                            <div class="studio-form__actions">
                                <a
                                    class="studio-button"
                                    id="oauth-login-btn"
                                    href="/studio/login"
                                    hidden
                                >
                                    {authMode === "oauth"
                                        ? "Log in with GitHub"
                                        : "Log in to Studio"}
                                </a>
                                <button
                                    class="studio-button studio-button--secondary"
                                    id="oauth-logout-btn"
                                    type="button"
                                    hidden
                                >
                                    Sign out
                                </button>
                            </div>
                        </div>
                    )
                }

                {
                    hasRemote && authMode === "team" && (
                        <div class="studio-panel">
                            <div class="studio-panel__header">
                                <h3>User management</h3>
                            </div>
                            <p class="studio-lead">
                                New accounts are created by the site owner
                                through the <a href={`${base}/studio/users`}>Users</a>
                                panel. Only the owner can add or remove
                                Studio accounts.
                            </p>
                        </div>
                    )
                }

                <form id="github-settings-form" class="studio-form" hidden={hasRemote}>
                    <div class="studio-field">
                        <label for="gh-token">
                            Personal access token
                            <span class="studio-field__required">*</span>
                        </label>
                        <input
                            id="gh-token"
                            name="token"
                            type="password"
                            autocomplete="off"
                            placeholder="github_pat_…"
                        />
                        <p class="studio-hint">
                            Create a fine-grained token with{" "}
                            <strong>Contents: Read and write</strong> and{" "}
                            <strong>Workflows: Read and write</strong> on this
                            repo. The token is kept for this session only and
                            lets the editor commit articles straight to GitHub.
                        </p>
                    </div>

                    <div class="studio-field-row">
                        <div class="studio-field">
                            <label for="gh-owner">Owner</label>
                            <input
                                id="gh-owner"
                                name="owner"
                                type="text"
                                placeholder="godlyaitm"
                                autocomplete="off"
                            />
                        </div>
                        <div class="studio-field">
                            <label for="gh-repo">Repository</label>
                            <input
                                id="gh-repo"
                                name="repo"
                                type="text"
                                placeholder="the-technology-joint-blog"
                                autocomplete="off"
                            />
                        </div>
                        <div class="studio-field">
                            <label for="gh-branch">Branch</label>
                            <input
                                id="gh-branch"
                                name="branch"
                                type="text"
                                placeholder="main"
                                autocomplete="off"
                            />
                        </div>
                    </div>

                    <hr class="studio-divider" />

                    <div class="studio-field">
                        <label for="gh-analytics">
                            Analytics domain
                            <span class="studio-hint">(optional)</span>
                        </label>
                        <input
                            id="gh-analytics"
                            name="analyticsDomain"
                            type="text"
                            placeholder="godlyaitm.github.io"
                            autocomplete="off"
                        />
                        <p class="studio-hint">
                            Your Simple Analytics hostname — the site you
                            registered there, without "https://". Enables the
                            traffic panel on the dashboard. Leave empty to use
                            the domain baked into the build
                            (<code>PUBLIC_ANALYTICS_DOMAIN</code>).
                        </p>
                    </div>

                    <div
                        class="studio-status"
                        id="github-status"
                        aria-live="polite"
                    ></div>

                    <div class="studio-form__actions">
                        <button class="studio-button" type="submit">
                            Save connection
                        </button>
                        <button
                            class="studio-button studio-button--secondary"
                            type="button"
                            id="test-connection"
                        >
                            Test connection
                        </button>
                    </div>
                </form>
            </article>

            <article class="studio-panel">
                <div class="studio-panel__header">
                    <h3>Editor defaults</h3>
                </div>
                <p class="studio-lead">
                    Pre-filled values for new articles. Stored on this device
                    only — you can still override them per article.
                </p>
                <form
                    id="defaults-form"
                    class="studio-form"
                    style="margin-top: 1rem"
                >
                    <div class="studio-field-row">
                        <div class="studio-field">
                            <label for="default-category">
                                Default category
                            </label>
                            <input
                                id="default-category"
                                name="category"
                                type="text"
                                placeholder="e.g. Cybersecurity"
                                autocomplete="off"
                            />
                        </div>
                        <div class="studio-field">
                            <label for="default-author">Default author</label>
                            <input
                                id="default-author"
                                name="author"
                                type="text"
                                placeholder="Israel Alabi"
                                autocomplete="off"
                            />
                        </div>
                    </div>
                    <div class="studio-field">
                        <label for="default-tags">
                            Default tags (comma separated)
                        </label>
                        <input
                            id="default-tags"
                            name="tags"
                            type="text"
                            placeholder="Security, Privacy"
                            autocomplete="off"
                        />
                    </div>
                    <div
                        class="studio-status"
                        id="defaults-status"
                        aria-live="polite"
                    ></div>
                    <div class="studio-form__actions">
                        <button class="studio-button" type="submit">
                            Save defaults
                        </button>
                    </div>
                </form>
            </article>
        </section>
    </StudioShell>
</BaseLayout>

<script>
    import {
        getStudioConfig,
        saveStudioConfig,
        testGitHubConnection,
        getSession,
        getLoginUrl,
        signOut,
        getApiBase,
        getAuthMode,
        DEFAULT_OWNER,
        DEFAULT_REPO,
        DEFAULT_BRANCH,
    } from "../../lib/studio/github";

    const apiBase = getApiBase();
    const authMode = getAuthMode();
    const base = import.meta.env.BASE_URL.replace(/\/$/, "");

    const form = document.getElementById(
        "github-settings-form",
    ) as HTMLFormElement | null;
    const status = document.getElementById(
        "github-status",
    ) as HTMLElement | null;
    const testBtn = document.getElementById(
        "test-connection",
    ) as HTMLButtonElement | null;

    /* ---- OAuth mode: show live session state ---- */
    const oauthStatusText = document.getElementById("oauth-status-text");
    const oauthLoginBtn = document.getElementById(
        "oauth-login-btn",
    ) as HTMLAnchorElement | null;
    const oauthLogoutBtn = document.getElementById(
        "oauth-logout-btn",
    ) as HTMLButtonElement | null;

    if (apiBase) {
        void getSession().then((session) => {
            if (oauthStatusText) {
                oauthStatusText.textContent = session?.authenticated
                    ? `Signed in as @${session.user?.login || "studio user"}. Saves and publishes commit to the live repository through the Studio API.`
                    : authMode === "oauth"
                        ? "Not signed in. Log in with GitHub to connect the Studio to the live repository."
                        : "Not signed in. Log in with your Studio account to connect the Studio to the live repository.";
            }
            if (oauthLoginBtn) {
                oauthLoginBtn.hidden = session?.authenticated === true;
                if (!session?.authenticated) {
                    oauthLoginBtn.href = getLoginUrl(`${base}/studio/settings`);
                }
            }
            if (oauthLogoutBtn) {
                oauthLogoutBtn.hidden = session?.authenticated !== true;
            }
        });

        oauthLogoutBtn?.addEventListener("click", async () => {
            await signOut();
            window.location.reload();
        });
    }

    /* ---- Editor defaults (per-device) ---- */
    const defaultsForm = document.getElementById(
        "defaults-form",
    ) as HTMLFormElement | null;
    const defaultsStatus = document.getElementById(
        "defaults-status",
    ) as HTMLElement | null;
    const DEFAULTS_KEY = "studio-editor-defaults";

    if (defaultsForm && defaultsStatus) {
        const categoryInput = document.getElementById(
            "default-category",
        ) as HTMLInputElement;
        const authorInput = document.getElementById(
            "default-author",
        ) as HTMLInputElement;
        const tagsInput = document.getElementById(
            "default-tags",
        ) as HTMLInputElement;

        // Pre-fill from stored defaults
        try {
            const raw = window.sessionStorage.getItem(DEFAULTS_KEY);
            if (raw) {
                const stored = JSON.parse(raw) as Record<string, string>;
                categoryInput.value = stored.category ?? "";
                authorInput.value = stored.author ?? "";
                tagsInput.value = stored.tags ?? "";
            }
        } catch {
            // ignore
        }

        defaultsForm.addEventListener("submit", (event) => {
            event.preventDefault();
            const defaults = {
                category: categoryInput.value.trim(),
                author: authorInput.value.trim(),
                tags: tagsInput.value.trim(),
            };
            try {
                window.sessionStorage.setItem(
                    DEFAULTS_KEY,
                    JSON.stringify(defaults),
                );
            } catch {
                defaultsStatus.className = "studio-status studio-status--error";
                defaultsStatus.textContent =
                    "Couldn't save defaults (storage unavailable).";
                return;
            }
            defaultsStatus.className = "studio-status studio-status--success";
            defaultsStatus.textContent =
                "Defaults saved — new articles will start with these values.";
        });
    }

    if (!apiBase) {
        if (!form || !status) {
            throw new Error("Studio settings failed to initialize.");
        }

        const tokenInput = form.elements.namedItem("token") as HTMLInputElement;
        const ownerInput = form.elements.namedItem("owner") as HTMLInputElement;
        const repoInput = form.elements.namedItem("repo") as HTMLInputElement;
        const branchInput = form.elements.namedItem("branch") as HTMLInputElement;
        const analyticsInput = form.elements.namedItem(
            "analyticsDomain",
        ) as HTMLInputElement;

        const setStatus = (
            message: string,
            kind: "info" | "success" | "error",
        ) => {
            status.className = "studio-status";
            if (kind === "success") status.classList.add("studio-status--success");
            if (kind === "error") status.classList.add("studio-status--error");
            status.textContent = message;
        };

        function readConfig() {
            return {
                token: tokenInput.value.trim(),
                owner: ownerInput.value.trim() || DEFAULT_OWNER,
                repo: repoInput.value.trim() || DEFAULT_REPO,
                branch: branchInput.value.trim() || DEFAULT_BRANCH,
                analyticsDomain: analyticsInput.value.trim() || undefined,
            };
        }

        /* Pre-fill from stored config */
        const stored = getStudioConfig();
        if (stored) {
            tokenInput.value = stored.token ?? "";
            ownerInput.value = stored.owner;
            repoInput.value = stored.repo;
            branchInput.value = stored.branch;
            analyticsInput.value = stored.analyticsDomain ?? "";
            setStatus(
                "Connected — token saved for this device.",
                "success",
            );
        } else {
            ownerInput.value = DEFAULT_OWNER;
            repoInput.value = DEFAULT_REPO;
            branchInput.value = DEFAULT_BRANCH;
            setStatus(
                "Not connected yet. Add a personal access token and save.",
                "info",
            );
        }

        form.addEventListener("submit", (event) => {
            event.preventDefault();
            const config = readConfig();
            if (!config.token && !config.analyticsDomain) {
                setStatus(
                    "Add a personal access token (or at least an analytics domain) before saving.",
                    "error",
                );
                return;
            }
            saveStudioConfig(config);
            setStatus(
                config.token
                    ? "Saved for this device. The editor can now commit articles to GitHub."
                    : "Analytics domain saved. Add a token when you're ready to publish from the editor.",
                "success",
            );
        });

        testBtn?.addEventListener("click", async () => {
            const config = readConfig();
            if (!config.token) {
                setStatus("Enter a token before testing.", "error");
                return;
            }
            testBtn.disabled = true;
            setStatus("Testing connection…", "info");
            const result = await testGitHubConnection(config);
            setStatus(result.message, result.ok ? "success" : "error");
            testBtn.disabled = false;
        });
    }
</script>
