---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StudioShell from "../../components/studio/StudioShell.astro";
import { hasApi } from "../../lib/studio/github";

// Build-safe: hasApi() returns false when PUBLIC_STUDIO_API_URL is unset,
// so the missing variable can never break the build or this page.
const hasOAuth = hasApi();
---

<BaseLayout
    title="Studio Settings | The Technology Joint"
    description="Configure Studio defaults and publishing preferences."
    noindex
>
    <StudioShell active="settings">
        <header class="studio-header">
            <div>
                <p class="studio-eyebrow">Workspace defaults</p>
                <h2>Studio settings</h2>
                <p class="studio-lead">
                    Connect the studio to GitHub so saves and publishes reach
                    the live site.
                </p>
            </div>
        </header>

        <section class="studio-grid studio-grid--settings">
            <article class="studio-panel">
                <div class="studio-panel__header">
                    <h3>GitHub connection</h3>
                </div>

                {
                    hasOAuth && (
                        <div
                            class="studio-panel studio-oauth-status"
                            id="oauth-status"
                        >
                            <div class="studio-panel__header">
                                <h3>GitHub OAuth</h3>
                            </div>
                            <p class="studio-lead" id="oauth-status-text">
                                Checking your GitHub session…
                            </p>
                            <div class="studio-form__actions">
                                <a
                                    class="studio-button"
                                    id="oauth-login-btn"
                                    href="/studio/login"
                                    hidden
                                >
                                    Log in with GitHub
                                </a>
                                <button
                                    class="studio-button studio-button--secondary"
                                    id="oauth-logout-btn"
                                    type="button"
                                    hidden
                                >
                                    Sign out
                                </button>
                            </div>
                        </div>
                    )
                }

                <form id="github-settings-form" class="studio-form" hidden={hasOAuth}>
                    <div class="studio-field">
                        <label for="gh-token">
                            Personal access token
                            <span class="studio-field__required">*</span>
                        </label>
                        <input
                            id="gh-token"
                            name="token"
                            type="password"
                            autocomplete="off"
                            placeholder="github_pat_…"
                        />
                        <p class="studio-hint">
                            Local-dev fallback: create a fine-grained token
                            with <strong>Contents: Read and write</strong> and{" "}
                            <strong>Workflows: Read and write</strong> on this
                            repo. When a Studio API worker is configured
                            (<code>PUBLIC_STUDIO_API_URL</code>), sign in with
                            GitHub instead and no token is needed.
                        </p>
                    </div>

                    <div class="studio-field-row">
                        <div class="studio-field">
                            <label for="gh-owner">Owner</label>
                            <input
                                id="gh-owner"
                                name="owner"
                                type="text"
                                placeholder="godlyaitm"
                                autocomplete="off"
                            />
                        </div>
                        <div class="studio-field">
                            <label for="gh-repo">Repository</label>
                            <input
                                id="gh-repo"
                                name="repo"
                                type="text"
                                placeholder="the-technology-joint-blog"
                                autocomplete="off"
                            />
                        </div>
                        <div class="studio-field">
                            <label for="gh-branch">Branch</label>
                            <input
                                id="gh-branch"
                                name="branch"
                                type="text"
                                placeholder="main"
                                autocomplete="off"
                            />
                        </div>
                    </div>

                    <hr class="studio-divider" />

                    <div class="studio-field">
                        <label for="gh-analytics">
                            Analytics domain
                            <span class="studio-hint">(optional)</span>
                        </label>
                        <input
                            id="gh-analytics"
                            name="analyticsDomain"
                            type="text"
                            placeholder="godlyaitm.github.io"
                            autocomplete="off"
                        />
                        <p class="studio-hint">
                            Your Simple Analytics hostname — the site you
                            registered there, without "https://". Enables the
                            traffic panel on the dashboard. Leave empty to use
                            the domain baked into the build
                            (<code>PUBLIC_ANALYTICS_DOMAIN</code>).
                        </p>
                    </div>

                    <div
                        class="studio-status"
                        id="github-status"
                        aria-live="polite"
                    ></div>

                    <div class="studio-form__actions">
                        <button class="studio-button" type="submit">
                            Save connection
                        </button>
                        <button
                            class="studio-button studio-button--secondary"
                            type="button"
                            id="test-connection"
                        >
                            Test connection
                        </button>
                    </div>
                </form>
            </article>

            <article class="studio-panel">
                <div class="studio-panel__header">
                    <h3>Brand defaults</h3>
                </div>
                <p class="studio-lead">
                    Set preferred tone, author signature, and default category
                    templates.
                </p>
            </article>

            <article class="studio-panel">
                <div class="studio-panel__header">
                    <h3>SEO defaults</h3>
                </div>
                <p class="studio-lead">
                    Configure meta templates, focus keywords, and internal link
                    suggestions.
                </p>
            </article>
        </section>
    </StudioShell>
</BaseLayout>

<script>
    import {
        getStudioConfig,
        saveStudioConfig,
        testGitHubConnection,
        getSession,
        getLoginUrl,
        signOut,
        getApiBase,
        DEFAULT_OWNER,
        DEFAULT_REPO,
        DEFAULT_BRANCH,
    } from "../../lib/studio/github";

    const apiBase = getApiBase();
    const base = import.meta.env.BASE_URL.replace(/\/$/, "");

    const form = document.getElementById(
        "github-settings-form",
    ) as HTMLFormElement | null;
    const status = document.getElementById(
        "github-status",
    ) as HTMLElement | null;
    const testBtn = document.getElementById(
        "test-connection",
    ) as HTMLButtonElement | null;

    /* ---- OAuth mode: show live session state ---- */
    const oauthStatusText = document.getElementById("oauth-status-text");
    const oauthLoginBtn = document.getElementById(
        "oauth-login-btn",
    ) as HTMLAnchorElement | null;
    const oauthLogoutBtn = document.getElementById(
        "oauth-logout-btn",
    ) as HTMLButtonElement | null;

    if (apiBase) {
        void getSession().then((session) => {
            if (oauthStatusText) {
                oauthStatusText.textContent = session?.authenticated
                    ? `Signed in as ${session.user?.name || session.user?.login || "GitHub user"} (@${session.user?.login || "—"}). Saves and publishes commit to the live repository through the Studio API.`
                    : "Not signed in. Log in with GitHub to connect the Studio to the live repository.";
            }
            if (oauthLoginBtn) {
                oauthLoginBtn.hidden = session?.authenticated === true;
                if (!session?.authenticated) {
                    oauthLoginBtn.href = getLoginUrl(`${base}/studio/settings`);
                }
            }
            if (oauthLogoutBtn) {
                oauthLogoutBtn.hidden = session?.authenticated !== true;
            }
        });

        oauthLogoutBtn?.addEventListener("click", async () => {
            await signOut();
            window.location.reload();
        });
    }

    if (!apiBase) {
        if (!form || !status) {
            throw new Error("Studio settings failed to initialize.");
        }

    const tokenInput = form.elements.namedItem("token") as HTMLInputElement;
    const ownerInput = form.elements.namedItem("owner") as HTMLInputElement;
    const repoInput = form.elements.namedItem("repo") as HTMLInputElement;
    const branchInput = form.elements.namedItem("branch") as HTMLInputElement;
    const analyticsInput = form.elements.namedItem(
        "analyticsDomain",
    ) as HTMLInputElement;

    const setStatus = (
        message: string,
        kind: "info" | "success" | "error",
    ) => {
        status.className = "studio-status";
        if (kind === "success") status.classList.add("studio-status--success");
        if (kind === "error") status.classList.add("studio-status--error");
        status.textContent = message;
    };

    function readConfig() {
        return {
            token: tokenInput.value.trim(),
            owner: ownerInput.value.trim() || DEFAULT_OWNER,
            repo: repoInput.value.trim() || DEFAULT_REPO,
            branch: branchInput.value.trim() || DEFAULT_BRANCH,
            analyticsDomain: analyticsInput.value.trim() || undefined,
        };
    }

    /* Pre-fill from stored config */
    const stored = getStudioConfig();
    if (stored) {
        tokenInput.value = stored.token ?? "";
        ownerInput.value = stored.owner;
        repoInput.value = stored.repo;
        branchInput.value = stored.branch;
        analyticsInput.value = stored.analyticsDomain ?? "";
        setStatus(
            "Connected — token saved for this device.",
            "success",
        );
    } else {
        ownerInput.value = DEFAULT_OWNER;
        repoInput.value = DEFAULT_REPO;
        branchInput.value = DEFAULT_BRANCH;
        setStatus(
            "Not connected yet. Add a personal access token and save.",
            "info",
        );
    }

    form.addEventListener("submit", (event) => {
        event.preventDefault();
        const config = readConfig();
        if (!config.token && !config.analyticsDomain) {
            setStatus(
                "Add a personal access token (or at least an analytics domain) before saving.",
                "error",
            );
            return;
        }
        saveStudioConfig(config);
        setStatus(
            config.token
                ? "Saved for this device. The editor can now commit articles to GitHub."
                : "Analytics domain saved. Add a token when you're ready to publish from the editor.",
            "success",
        );
    });

    testBtn?.addEventListener("click", async () => {
        const config = readConfig();
        if (!config.token) {
            setStatus("Enter a token before testing.", "error");
            return;
        }
        testBtn.disabled = true;
        setStatus("Testing connection…", "info");
        const result = await testGitHubConnection(config);
        setStatus(result.message, result.ok ? "success" : "error");
        testBtn.disabled = false;
    });
    }
</script>
