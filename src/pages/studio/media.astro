---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StudioShell from "../../components/studio/StudioShell.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
    title="Studio Media | The Technology Joint"
    description="Media library for the private Studio workspace."
    noindex
>
    <StudioShell active="media">
        <header class="studio-header">
            <div>
                <p class="studio-eyebrow">Media workspace</p>
                <h2>Media manager</h2>
                <p class="studio-lead">
                    Hero images are uploaded per-article in the editor and
                    committed to the site with each save.
                </p>
            </div>
        </header>

        <section class="studio-panel">
            <div class="studio-panel__header">
                <h3>Getting started</h3>
            </div>
            <p class="studio-lead">
                Open any article in the editor, choose your image in the
                <strong>Hero image</strong> section, and it will be uploaded
                to <code>public/images/articles/</code> when you save or
                publish. A full asset library is planned for a future update.
            </p>
            <div class="studio-form__actions" style="margin-top: 1rem">
                <a
                    class="studio-button"
                    href={`${base}/studio/editor`}
                    >Open the editor</a
                >
            </div>
        </section>
    </StudioShell>
</BaseLayout>
